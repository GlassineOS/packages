# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# The Onyx Boox Note Air's system services and scripts. Its configuration files
# (sysctl, sound routing) are in the device stage of GlassineOS/images, except the
# panel adapter (/etc/glassine/epd.conf), the device seed's list and Android's slot
# (/etc/glassine/slots.conf, for the power menu), which go with the tools that read them.
# onyx-noteair-bringup brings up the modem, ADSP, WiFi, Bluetooth and the sound card
# (with its modprobe.d file and the speaker and microphone routing). The images
# device stage adds glassine-device-seed to sysinit.
pkgname=device-onyx-noteair
pkgver=3
pkgrel=0
builddir="$srcdir"
pkgdesc="Onyx Boox Note Air: system services, device seed, modem, radios and sound"
url="https://github.com/GlassineOS/packages"
arch="noarch"
license="GPL-2.0-or-later"
# e2fsprogs-extra (it needs e2fsprogs): dumpe2fs and debugfs (the seed reads ext4 without mounting)
# glassine-slot: the power menu's "Android" switches to the slot slots.conf names
# onyx-noteair-bringup: qrtr (qrtr-lookup, to look at the modem's services), rmtfs and
# tqftpserv (the modem's file systems and file server), qrtr-diag-sink (without it the
# WLAN firmware takes the modem down), alsa-utils (amixer: the sound routing)
depends="busybox e2fsprogs e2fsprogs-extra glassine-epdd glassine-slot
	alsa-utils qrtr qrtr-diag-sink rmtfs tqftpserv"
source="device-seed.conf
	epd.conf
	glassine-clock
	glassine-clock.initd
	glassine-clock.nm-dispatcher
	glassine-ddr
	glassine-device-seed
	glassine-device-seed.initd
	glassine-session.confd
	glassine-splash.initd
	onyx-noteair-bringup
	onyx-noteair-bringup.initd
	onyx-noteair-bringup.modprobe
	onyx-noteair-tune.initd
	slots.conf
	waveform.health
	"

build() {
	# the splash: a white page at the panel's size (portrait, 8-bit grey)
	{ printf 'P5\n1404 1872\n255\n'; head -c $((1404 * 1872)) /dev/zero | tr '\0' '\377'; } > "$srcdir"/splash.pgm
}

check() {
	local f t rc
	for f in glassine-clock glassine-clock.initd glassine-clock.nm-dispatcher glassine-ddr \
		glassine-device-seed glassine-device-seed.initd glassine-session.confd \
		glassine-splash.initd onyx-noteair-bringup onyx-noteair-bringup.initd \
		onyx-noteair-tune.initd waveform.health; do
		sh -n "$srcdir/$f" || return 1
	done
	t="$srcdir/t"; rm -rf "$t"; mkdir -p "$t/p" "$t/cg" "$t/pip"

	# the clock: the offset is system time - RTC
	echo 1000 > "$t/rtc"
	GLASSINE_CLOCK_RTC="$t/rtc" GLASSINE_CLOCK_OFFSET="$t/off" sh "$srcdir/glassine-clock" save
	[ $(( $(date +%s) - 1000 - $(cat "$t/off") )) -le 2 ] || { echo "clock: offset $(cat "$t/off")"; return 1; }

	# the power modes against stand-in sysfs files
	for f in ddr_table ddr_min_kbps ddr_max_kbps; do : > "$t/p/$f"; done
	: > "$t/cg/cpu.uclamp.min"; : > "$t/pip/pip"
	ddr() {
		GLASSINE_DDR_PARAMS="$t/p" GLASSINE_UCLAMP_CG="$t/cg" GLASSINE_PIP_GLOB="$t/pip/pip" \
		GLASSINE_EPDD_CTL="$t/ctl" GLASSINE_DDR_SAVED="$t/ddr" sh "$srcdir/glassine-ddr" "$@" 2>/dev/null
	}
	[ "$(ddr)" = performance ] || { echo "ddr: no saved mode is not performance"; return 1; }
	[ "$(cat "$t/p/ddr_table") $(cat "$t/p/ddr_min_kbps") $(cat "$t/cg/cpu.uclamp.min")" = "cmax 5163000 60" ] \
		|| { echo "ddr: performance applied wrong"; return 1; }
	ddr saver >/dev/null
	[ "$(cat "$t/ddr") $(cat "$t/p/ddr_table") $(cat "$t/p/ddr_min_kbps") $(cat "$t/cg/cpu.uclamp.min")" = "saver stock 0 0" ] \
		|| { echo "ddr: saver not saved or applied"; return 1; }
	[ "$(ddr epdd-opts)" = boost=0 ] || { echo "ddr: saver keeps the boost"; return 1; }
	ddr balanced >/dev/null
	[ "$(ddr epdd-opts)" = boost=150 ] && [ "$(cat "$t/p/ddr_table")" = cmax ] || { echo "ddr: balanced"; return 1; }
	echo nonsense > "$t/ddr"
	[ "$(ddr)" = performance ] || { echo "ddr: an unknown saved mode is not performance"; return 1; }
	rc=0; ddr fast >/dev/null || rc=$?
	[ $rc = 2 ] || { echo "ddr: an unknown level is accepted"; return 1; }
	rm "$t/p/ddr_table"
	ddr saver >/dev/null; [ "$(cat "$t/p/ddr_max_kbps")" = 2086000 ] || { echo "ddr: no table, no cap"; return 1; }
	rm "$t/p/ddr_min_kbps"
	rc=0; ddr >/dev/null || rc=$?
	[ $rc = 1 ] || { echo "ddr: no voter is not an error"; return 1; }
	[ "$(cat "$t/cg/cpu.uclamp.min")" = 0 ] || { echo "ddr: no voter, no floor"; return 1; }

	_check_seed "$t/seed" || return 1
	_check_bringup "$t/bringup"
}

# the device seed on plain directories (GLASSINE_SEED_FAKE): first seed, verify,
# a damaged copy, a source that can't be read, a refresh, a cut-off write, the
# journal, a bad waveform, the health check
_check_seed() {
	local d="$1" f=$1/fake rc h
	rm -rf "$d"; mkdir -p "$f/src/system_a/waveform" "$d/run" "$d/bin"
	# blkid: the line in SRC.blkid, as busybox prints it (it ignores -o and -s)
	printf '#!/bin/sh\ncat "$1.blkid" 2>/dev/null\n' > "$d/bin/blkid"; chmod +x "$d/bin/blkid"
	echo "$f/src/system_a: UUID=\"a46c\" TYPE=\"ext4\"" > "$f/src/system_a.blkid"
	# a waveform with a correct header: the file's length at offset 4
	_wbf() {
		local n=$1
		{ printf 'WBF\0'; printf "\\$(printf %o $((n & 255)))\\$(printf %o $((n >> 8 & 255)))\\$(printf %o $((n >> 16 & 255)))\\$(printf %o $((n >> 24 & 255)))"
		  head -c $((n - 8)) /dev/urandom; } > "$2"
	}
	_wbf 4096 "$f/src/system_a/waveform/eink_waveform.wbf"
	printf 'DEVICE_PART=vendor_b\nwaveform.wbf system_a:/waveform/eink_waveform.wbf wbf # the panel\n' > "$d/conf"
	seed() { PATH="$d/bin:$PATH" GLASSINE_SEED_CONF="$d/conf" GLASSINE_SEED_RUN="$d/run" GLASSINE_SEED_FAKE="$f" \
		GLASSINE_SEED_REQUEST="$d/request" sh "$srcdir/glassine-device-seed" "$@" 2>>"$d/log"; }
	S=$f/part/glassine

	seed || { echo "seed: first seed failed"; cat "$d/log"; return 1; }
	cmp -s "$S/waveform.wbf" "$f/src/system_a/waveform/eink_waveform.wbf" || { echo "seed: copy differs"; return 1; }
	[ "$(head -n1 "$S/manifest")" = format=1 ] && grep -q "^waveform.wbf system_a:/waveform/eink_waveform.wbf $(sha256sum "$S/waveform.wbf" | cut -d' ' -f1)\$" "$S/manifest" \
		|| { echo "seed: manifest"; cat "$S/manifest"; return 1; }
	[ "$(wc -l < "$S/manifest")" = 2 ] || { echo "seed: manifest is not format=1 and one line per file"; cat -A "$S/manifest"; return 1; }
	[ -f "$d/run/device/waveform.wbf" ] || { echo "seed: not bound"; return 1; }
	ls -a "$S" | grep -q '\.new' && { echo "seed: temp files left"; return 1; }

	# bound: nothing to do, even with the source gone
	mv "$f/src/system_a" "$f/src/gone"
	seed || { echo "seed: a bound seed is redone"; return 1; }
	seed status >/dev/null || { echo "seed: status of a complete seed"; return 1; }
	# the boot again (nothing bound): verified, bound, the source not needed
	rm "$d/run/device"; seed || { echo "seed: verify without the source"; return 1; }
	[ -f "$d/run/device/waveform.wbf" ] || { echo "seed: verified seed not bound"; return 1; }

	# a damaged copy and no source: incomplete, nothing bound
	rm "$d/run/device"; echo x >> "$S/waveform.wbf"
	rc=0; seed || rc=$?
	[ $rc = 1 ] && [ ! -e "$d/run/device" ] || { echo "seed: a damaged copy is bound (rc $rc)"; return 1; }
	# the source back: copied again
	mv "$f/src/gone" "$f/src/system_a"
	seed || { echo "seed: damaged copy not replaced"; return 1; }
	cmp -s "$S/waveform.wbf" "$f/src/system_a/waveform/eink_waveform.wbf" || { echo "seed: replaced copy differs"; return 1; }

	# refresh: read again; a source that can't be read keeps the seed's copy
	_wbf 8192 "$f/src/system_a/waveform/eink_waveform.wbf"
	seed refresh --now || { echo "seed: refresh failed"; return 1; }
	[ "$(wc -c < "$S/waveform.wbf")" = 8192 ] || { echo "seed: refresh did not copy"; return 1; }
	[ "$(wc -l < "$S/manifest")" = 2 ] || { echo "seed: refresh's manifest"; cat -A "$S/manifest"; return 1; }
	mv "$f/src/system_a" "$f/src/gone"
	rc=0; seed refresh --now || rc=$?
	mv "$f/src/gone" "$f/src/system_a"
	[ $rc = 1 ] && [ "$(wc -c < "$S/waveform.wbf")" = 8192 ] && [ -f "$d/run/device/waveform.wbf" ] \
		|| { echo "seed: refresh without a source lost the copy (rc $rc)"; return 1; }

	# refresh without --now: only the request; the next start refreshes even
	# though the seed is bound, and clears it; an unreadable source keeps it
	_wbf 6144 "$f/src/system_a/waveform/eink_waveform.wbf"
	seed refresh >/dev/null || { echo "seed: refresh request failed"; return 1; }
	[ -e "$d/request" ] && [ "$(wc -c < "$S/waveform.wbf")" = 8192 ] || { echo "seed: refresh request changed the seed now"; return 1; }
	mv "$f/src/system_a" "$f/src/gone"
	rc=0; seed || rc=$?
	mv "$f/src/gone" "$f/src/system_a"
	[ $rc = 1 ] && [ -e "$d/request" ] && [ -f "$d/run/device/waveform.wbf" ] || { echo "seed: a request with no source was dropped (rc $rc)"; return 1; }
	seed || { echo "seed: the requested refresh failed"; return 1; }
	[ ! -e "$d/request" ] && [ "$(wc -c < "$d/run/device/waveform.wbf")" = 6144 ] || { echo "seed: the request was not done at start"; return 1; }
	_wbf 8192 "$f/src/system_a/waveform/eink_waveform.wbf"; seed refresh --now || { echo "seed: back to 8192"; return 1; }
	rc=0; seed refresh --later 2>/dev/null || rc=$?
	[ $rc = 2 ] || { echo "seed: an unknown option is accepted"; return 1; }

	# a write that fails (cp stops after 100 bytes of the temp file): no temp
	# file left, the old copy verified and bound
	_cpfail() {
		printf '#!/bin/sh\ncase $2 in */glassine/.*.new) head -c 100 "$1" > "$2"; exit 1 ;; esac\nexec %s "$@"\n' \
			"$(command -v cp)" > "$d/bin/cp"; chmod +x "$d/bin/cp"
	}
	_cpfail; _wbf 4096 "$f/src/system_a/waveform/eink_waveform.wbf"
	rc=0; seed refresh --now || rc=$?
	rm "$d/bin/cp"
	[ $rc = 1 ] && grep -q "writing the seed failed" "$d/log" || { echo "seed: a failed write is not a failure (rc $rc)"; return 1; }
	ls -a "$S" | grep -q '\.new' && { echo "seed: a failed write left its temp file"; ls -a "$S"; return 1; }
	[ "$(wc -c < "$d/run/device/waveform.wbf")" = 8192 ] && seed status >/dev/null \
		|| { echo "seed: the old copy is not bound after a failed write"; return 1; }
	# the list names another file and its write fails: the file the old manifest
	# names is kept, and the old seed bound
	mv "$d/conf" "$d/conf.orig"
	printf 'DEVICE_PART=vendor_b\nother.wbf system_a:/waveform/eink_waveform.wbf wbf\n' > "$d/conf"
	_cpfail; rm "$d/run/device"
	rc=0; seed || rc=$?
	rm "$d/bin/cp"; mv "$d/conf.orig" "$d/conf"
	[ $rc = 1 ] && [ -f "$S/waveform.wbf" ] && [ "$(wc -c < "$d/run/device/waveform.wbf")" = 8192 ] \
		|| { echo "seed: a failed write removed what the old manifest names (rc $rc)"; ls -a "$S"; return 1; }

	# the read-write mount is refused: the seed is mounted read-only again and bound
	: > "$f/rw_fails"
	rc=0; seed refresh --now || rc=$?
	rm "$f/rw_fails"
	[ $rc = 1 ] && grep -q "cannot mount vendor_b read-write" "$d/log" && [ "$(wc -c < "$d/run/device/waveform.wbf")" = 8192 ] \
		&& seed status >/dev/null || { echo "seed: not bound again after a refused read-write mount (rc $rc)"; return 1; }

	# cut off before the manifest's rename: no manifest = no seed, copied again
	rm "$d/run/device" "$S/manifest"; : > "$S/.manifest.new"
	seed || { echo "seed: no manifest not redone"; return 1; }
	[ -f "$S/manifest" ] || { echo "seed: no manifest written"; return 1; }

	# the journal needs recovery: replayed, then verified
	rm "$d/run/device"; : > "$f/needs_recovery"
	seed || { echo "seed: journal"; return 1; }
	[ ! -e "$f/needs_recovery" ] && grep -q "replaying" "$d/log" || { echo "seed: journal not replayed"; return 1; }

	# a source that isn't a waveform: not copied, nothing bound
	rm -rf "$f/part" "$d/run/device"; head -c 4096 /dev/zero > "$f/src/system_a/waveform/eink_waveform.wbf"
	rc=0; seed || rc=$?
	[ $rc = 1 ] && [ ! -e "$S/waveform.wbf" ] || { echo "seed: a bad waveform was copied (rc $rc)"; return 1; }

	# the source's file system from util-linux's blkid (SEC_TYPE, PTTYPE): read;
	# one the seed doesn't read: nothing copied
	_wbf 4096 "$f/src/system_a/waveform/eink_waveform.wbf"
	echo '/dev/sda5: LABEL="system" SEC_TYPE="ext2" TYPE="ext3" PARTLABEL="system_a" PTTYPE="dos"' > "$f/src/system_a.blkid"
	rm -rf "$f/part" "$d/run/device"
	seed || { echo "seed: util-linux blkid output not read"; cat "$d/log"; return 1; }
	echo '/dev/sda5: UUID="a46c" TYPE="squashfs"' > "$f/src/system_a.blkid"
	rm -rf "$f/part" "$d/run/device"; rc=0; seed || rc=$?
	[ $rc = 1 ] && [ ! -e "$S/waveform.wbf" ] && grep -q "file system 'squashfs' not read" "$d/log" \
		|| { echo "seed: an unknown file system was read (rc $rc)"; return 1; }

	# the health check against a seed path
	h="$srcdir/waveform.health"
	_wbf 4096 "$d/w.wbf"
	printf 'waveform=/nowhere # comment\nwaveform=%s  \n' "$d/w.wbf" > "$d/epd.conf"
	GLASSINE_EPD_CONF="$d/epd.conf" sh "$h" || { echo "health: a good waveform"; return 1; }
	echo x >> "$d/w.wbf"
	[ "$(GLASSINE_EPD_CONF="$d/epd.conf" sh "$h")" = "waveform at $d/w.wbf is damaged" ] || { echo "health: damaged"; return 1; }
	rm "$d/w.wbf"
	[ "$(GLASSINE_EPD_CONF="$d/epd.conf" sh "$h")" = "no waveform at $d/w.wbf" ] || { echo "health: missing"; return 1; }
	: > "$d/epd.conf"
	GLASSINE_EPD_CONF="$d/epd.conf" sh "$h" >/dev/null && { echo "health: no waveform= passes"; return 1; }
	return 0
}

# onyx-noteair-bringup on a stand-in tree: fake remoteprocs, partitions, sound card
# and session, and stand-ins on PATH for every command that touches the hardware or
# a daemon (they log their calls to $B/calls). The sleep stand-in returns at once,
# turns a remoteproc state "start" into "running" and moves the kernel log and the
# uptime on to the next round's files (dmesg.N, uptime.N).
_check_bringup() {
	local B="$1" rc s P W bin="$1/bin"
	_bt_tree() {
		for f in "$B"/*.pid "$B"/run/*.pid; do
			[ -s "$f" ] && kill "$(cat "$f")" 2>/dev/null || :
		done
		rm -rf "$B"; mkdir -p "$bin" "$B/dev" "$B/parts" "$B/run" "$B/proc/asound" "$B/sys/class/net" "$B/sys/class/bluetooth"
		local r=$B/sys/class/remoteproc
		mkdir -p "$r/remoteproc0/device" "$r/remoteproc1/device"
		echo 4080000.remoteproc > "$r/remoteproc0/name"
		echo 'of:NremoteprocT(null)Cqcom,sdm660-mss-pil' > "$r/remoteproc0/device/modalias"
		echo offline > "$r/remoteproc0/state"
		echo adsp > "$r/remoteproc1/name"
		echo 'of:NremoteprocT(null)Cqcom,sdm660-adsp-pas' > "$r/remoteproc1/device/modalias"
		echo offline > "$r/remoteproc1/state"
		for p in modemst1 modemst2 fsc fsg; do head -c 4096 /dev/urandom > "$B/parts/$p"; done
		(cd "$B/parts" && sha256sum modemst1 modemst2 fsc fsg) > "$B/parts.sha"
		echo "100.00 50.00" > "$B/proc/uptime"; : > "$B/dmesg"; : > "$B/calls"; echo 0 > "$B/round"
		cat > "$bin/modprobe" <<-'S'
		#!/bin/sh
		echo "modprobe $*" >> "$B/calls"
		grep -qx "$1" "$B/fail_modules" 2>/dev/null && exit 1
		case $1 in
		rmtfs_mem) : > "$B/dev/qcom_rmtfs_mem1" ;;
		ath10k_snoc) mkdir -p "$B/sys/class/net/wlan0" ;;
		hci_uart) mkdir -p "$B/sys/class/bluetooth/hci0" ;;
		snd-soc-sm8250) printf ' 0 [NoteAir        ]: sdm660 - Onyx Note Air\n                      Onyx Note Air\n' > "$B/proc/asound/cards" ;;
		esac
		exit 0
		S
		cat > "$bin/start-stop-daemon" <<-'S'
		#!/bin/sh
		act= pf= exe= args=
		while [ $# -gt 0 ]; do
			case $1 in
			--start) act=start ;; --stop) act=stop ;;
			--pidfile|--stdout|--stderr|--exec|--retry) [ $1 = --pidfile ] && pf=$2; [ $1 = --exec ] && exe=$2; shift ;;
			--) shift; args="$*"; break ;;
			esac
			shift
		done
		n=$(basename "$pf" .pid)
		echo "ssd $act $n $exe $args" >> "$B/calls"
		if [ $act = start ]; then
			/bin/sleep 300 & echo $! > "$pf"
			[ $n = rmtfs ] && echo running > "$B/sys/class/remoteproc/remoteproc0/state"
		else
			kill "$(cat "$pf")"
		fi
		exit 0
		S
		cat > "$bin/sleep" <<-'S'
		#!/bin/sh
		for s in "$B"/sys/class/remoteproc/*/state; do [ "$(cat "$s")" = start ] && echo running > "$s"; done
		n=$(( $(cat "$B/round") + 1 )); echo $n > "$B/round"
		[ -f "$B/dmesg.$n" ] && cp "$B/dmesg.$n" "$B/dmesg"
		[ -f "$B/uptime.$n" ] && cp "$B/uptime.$n" "$B/proc/uptime"
		exit 0
		S
		printf '#!/bin/sh\necho "amixer $*" >> "$B/calls"\n[ ! -e "$B/amixer_fails" ]\n' > "$bin/amixer"
		printf '#!/bin/sh\necho "rmmod $*" >> "$B/calls"\n' > "$bin/rmmod"
		printf '#!/bin/sh\ncat "$B/dmesg"\n' > "$bin/dmesg"
		printf '#!/bin/sh\n[ -s "$B/wp.pid" ] && cat "$B/wp.pid"\n' > "$bin/pgrep"
		printf '#!/bin/sh\nwhile [ $# -gt 0 ] && [ "$1" != -c ]; do shift; done\nexec sh -c "$2"\n' > "$bin/su"
		printf '#!/bin/sh\necho "wpctl $* $XDG_RUNTIME_DIR" >> "$B/calls"\n[ -e "$B/wp_has_alsa" ] && echo " 45. Onyx Note Air [alsa]"\nexit 0\n' > "$bin/wpctl"
		printf '#!/bin/sh\necho "setsid $* FOO=$FOO" >> "$B/calls"\n' > "$bin/setsid"
		chmod +x "$bin"/*
	}
	# a session WirePlumber: a real process, its environment in the fake /proc
	_bt_wp() {
		/bin/sleep 300 & W=$!; echo $W > "$B/wp.pid"
		mkdir -p "$B/proc/$W"; printf 'XDG_RUNTIME_DIR=/run/user/1000\0FOO=bar\0' > "$B/proc/$W/environ"
	}
	bu() {
		B="$B" PATH="$bin:$PATH" GLASSINE_BRINGUP_SYS="$B/sys" GLASSINE_BRINGUP_DEV="$B/dev" \
			GLASSINE_BRINGUP_PROC="$B/proc" GLASSINE_BRINGUP_RUN="$B/run" GLASSINE_BRINGUP_PARTS="$B/parts" \
			sh "$srcdir/onyx-noteair-bringup" "$@" >> "$B/log" 2>&1
	}
	# line number of the first call matching a pattern (0: none)
	at() { grep -n -m1 -- "$1" "$B/calls" | cut -d: -f1 | grep . || echo 0; }
	export B

	# all steps, in order
	_bt_tree; _bt_wp; : > "$B/wp_has_alsa"
	bu up || { echo "bringup: up failed"; cat "$B/log"; return 1; }
	s="$(at 'ssd start qrtr-diag-sink') $(at 'ssd start tqftpserv') $(at 'ssd start rmtfs') $(at 'modprobe qcom_q6v5_pas') $(at 'modprobe ath10k_snoc') $(at 'modprobe hci_uart') $(at 'amixer')"
	echo "$s" | awk '{ for (i = 1; i <= NF; i++) if ($i == 0 || (i > 1 && $i <= $(i - 1))) exit 1 }' \
		|| { echo "bringup: steps out of order ($s)"; cat "$B/calls"; return 1; }
	[ "$(at 'modprobe rmtfs_mem')" -lt "$(at 'ssd start rmtfs')" ] || { echo "bringup: rmtfs before its memory"; return 1; }
	grep -q "^ssd start rmtfs /usr/bin/rmtfs -r -s -o $B/run/efs\$" "$B/calls" \
		|| { echo "bringup: rmtfs not read-only on the copies"; grep rmtfs "$B/calls"; return 1; }
	for s in modemst1:modem_fs1 modemst2:modem_fs2 fsc:modem_fsc fsg:modem_fsg; do
		cmp -s "$B/parts/${s%%:*}" "$B/run/efs/${s#*:}" || { echo "bringup: copy of ${s%%:*} differs"; return 1; }
	done
	(cd "$B/parts" && sha256sum -c -s "$B/parts.sha") || { echo "bringup: a partition changed"; return 1; }
	[ "$(cat "$B/sys/class/remoteproc/remoteproc1/state")" = running ] || { echo "bringup: the ADSP not started"; return 1; }
	[ "$(grep -c '^amixer -q -c 0 cset' "$B/calls")" = 6 ] || { echo "bringup: speaker and microphone not routed on card 0"; return 1; }
	grep -q "^wpctl status /run/user/1000" "$B/calls" && grep -q "WirePlumber has the sound card" "$B/log" \
		&& ! grep -q '^setsid' "$B/calls" && kill -0 "$W" || { echo "bringup: WirePlumber with the card restarted"; return 1; }
	grep -q "up: done$" "$B/log" || { echo "bringup: no done line"; return 1; }
	# up again: the copies and the running daemons are kept, WiFi is loaded again
	cp "$B/parts/fsg" "$B/fsg.orig"; head -c 4096 /dev/urandom > "$B/parts/fsg"; : > "$B/calls"
	bu up || { echo "bringup: up again failed"; cat "$B/log"; return 1; }
	cmp -s "$B/fsg.orig" "$B/run/efs/modem_fsg" && ! grep -q '^ssd start' "$B/calls" && [ "$(at 'modprobe ath10k_snoc')" != 0 ] \
		|| { echo "bringup: up again redid the copies or the daemons, or skipped WiFi"; cat "$B/calls"; return 1; }
	bu status && grep -q "^rmtfs: running" "$B/log" && grep -q "^sound card: 0" "$B/log" || { echo "bringup: status"; return 1; }
	# down: every daemon stopped, rmtfs first
	: > "$B/calls"; bu down
	[ "$(at 'ssd stop rmtfs')" = 1 ] && [ "$(grep -c '^ssd stop' "$B/calls")" = 3 ] && ! ls "$B"/run/*.pid >/dev/null 2>&1 \
		|| { echo "bringup: down"; cat "$B/calls"; return 1; }

	# a failed step is logged and the next ones still run
	_bt_tree; echo ath10k_snoc > "$B/fail_modules"; : > "$B/log"
	rc=0; bu up || rc=$?
	[ $rc = 1 ] && grep -q "modprobe ath10k_snoc failed" "$B/log" && grep -q "up: done, failed: wifi$" "$B/log" \
		&& [ "$(at 'modprobe hci_uart')" != 0 ] && [ "$(at amixer)" != 0 ] || { echo "bringup: a failed WiFi stopped the rest (rc $rc)"; cat "$B/log"; return 1; }
	# no rmtfs memory: no daemon, the modem fails, the rest runs
	_bt_tree; echo rmtfs_mem > "$B/fail_modules"; : > "$B/log"
	rc=0; bu up || rc=$?
	[ $rc = 1 ] && grep -q "failed: modem" "$B/log" && ! grep -q '^ssd start' "$B/calls" \
		&& [ "$(at 'modprobe qcom_q6v5_pas')" != 0 ] && [ "$(at 'modprobe hci_uart')" != 0 ] && [ "$(at amixer)" != 0 ] \
		|| { echo "bringup: no modem stopped the rest (rc $rc)"; cat "$B/log"; return 1; }
	# a partition that can't be read: logged, no partial copy, the modem step fails
	_bt_tree; rm "$B/parts/fsc"; : > "$B/log"
	rc=0; bu up || rc=$?
	[ $rc = 1 ] && grep -q "reading fsc failed" "$B/log" && [ ! -e "$B/run/efs/modem_fsc" ] && ! ls -a "$B/run/efs" | grep -q '\.new' \
		|| { echo "bringup: an unreadable partition (rc $rc)"; cat "$B/log"; return 1; }
	# a sound card that never appears: logged, nothing routed
	_bt_tree; echo snd-soc-sm8250 > "$B/fail_modules"; : > "$B/log"
	rc=0; bu up || rc=$?
	[ $rc = 1 ] && grep -q "the sound card: not there after 60 s" "$B/log" && [ "$(at amixer)" = 0 ] \
		|| { echo "bringup: no sound card (rc $rc)"; cat "$B/log"; return 1; }

	# the workaround: WirePlumber lists no ALSA device -> started again with its environment
	_bt_tree; _bt_wp; : > "$B/log"
	bu up || { echo "bringup: up for the WirePlumber case"; cat "$B/log"; return 1; }
	s=0; while ! grep -q '^setsid' "$B/calls" && [ $s -lt 50 ]; do /bin/sleep 0.1; s=$((s + 1)); done
	grep -q "^setsid /usr/bin/wireplumber FOO=bar$" "$B/calls" && grep -q "WirePlumber missed the sound card" "$B/log" \
		&& ! kill -0 "$W" 2>/dev/null || { echo "bringup: WirePlumber not restarted with its environment"; cat "$B/calls"; return 1; }

	# the breaker: modem crashes at 100, 120, 140 s -> ath10k unloaded; the crash
	# before the watch started doesn't count
	_bt_tree; : > "$B/log"
	m='remoteproc remoteproc0: handling crash #%s in 4080000.remoteproc'
	printf "[ 50.0] $m\n" 1 > "$B/dmesg"
	for s in 2:100 3:120 4:140; do
		{ cat "$B/dmesg.$((${s%:*} - 2))" 2>/dev/null || cat "$B/dmesg"; printf "[ ${s#*:}.0] qcom-q6v5-mss 4080000.remoteproc: fatal error received: dog_hb.c: Task starvation: diag\n[ ${s#*:}.1] $m\n" ${s%:*}; } > "$B/dmesg.$((${s%:*} - 1))"
		echo "${s#*:}.5 1.0" > "$B/uptime.$((${s%:*} - 1))"
	done
	GLASSINE_BRINGUP_WATCH_ROUNDS=5 bu watch
	[ "$(grep -c '^rmmod ath10k_snoc ath10k_core$' "$B/calls")" = 1 ] && grep -q "crash loop (3 modem crashes within 60 s)" "$B/log" \
		&& grep -q "modem crash #2: dog_hb.c: Task starvation: diag" "$B/log" || { echo "bringup: the breaker didn't trip"; cat "$B/log" "$B/calls"; return 1; }
	# the same crashes 40 s apart: no unload
	echo 0 > "$B/round"; : > "$B/calls"; printf "[ 50.0] $m\n" 1 > "$B/dmesg"
	for s in 1:100 2:140 3:180; do echo "${s#*:}.5 1.0" > "$B/uptime.${s%:*}"; done
	GLASSINE_BRINGUP_WATCH_ROUNDS=5 bu watch
	! grep -q '^rmmod' "$B/calls" || { echo "bringup: the breaker tripped on crashes 40 s apart"; return 1; }
	# three ADSP crashes within a minute: not the modem, no unload
	echo 0 > "$B/round"; : > "$B/calls"; : > "$B/dmesg"
	for s in 1 2 3; do sed "s/4080000\.remoteproc\$/adsp/" "$B/dmesg.$s" > "$B/dmesg.$s.x"; mv "$B/dmesg.$s.x" "$B/dmesg.$s"; echo "10$s.5 1.0" > "$B/uptime.$s"; done
	GLASSINE_BRINGUP_WATCH_ROUNDS=5 bu watch
	! grep -q '^rmmod' "$B/calls" || { echo "bringup: the breaker tripped on ADSP crashes"; return 1; }
	# a daemon that died is started again
	echo 0 > "$B/round"; : > "$B/calls"; echo 999999 > "$B/run/rmtfs.pid"
	GLASSINE_BRINGUP_WATCH_ROUNDS=2 bu watch
	grep -q "^ssd start rmtfs" "$B/calls" && grep -q "rmtfs is gone: starting it again" "$B/log" \
		&& ! grep -q "^ssd start tqftpserv" "$B/calls" || { echo "bringup: a dead rmtfs not restarted"; cat "$B/calls"; return 1; }

	rc=0; bu nonsense || rc=$?
	[ $rc = 2 ] || { echo "bringup: an unknown command exits $rc"; return 1; }
	_bt_tree
	return 0
}

package() {
	install -Dm755 "$srcdir"/glassine-clock "$pkgdir"/usr/sbin/glassine-clock
	install -Dm755 "$srcdir"/glassine-ddr "$pkgdir"/usr/sbin/glassine-ddr
	install -Dm755 "$srcdir"/glassine-device-seed "$pkgdir"/usr/sbin/glassine-device-seed
	install -Dm755 "$srcdir"/glassine-device-seed.initd "$pkgdir"/etc/init.d/glassine-device-seed
	install -Dm644 "$srcdir"/device-seed.conf "$pkgdir"/etc/glassine/device-seed.conf
	install -Dm644 "$srcdir"/epd.conf "$pkgdir"/etc/glassine/epd.conf
	install -Dm644 "$srcdir"/slots.conf "$pkgdir"/etc/glassine/slots.conf
	install -Dm755 "$srcdir"/waveform.health "$pkgdir"/etc/glassine-bootimg/health.d/50-waveform
	install -Dm755 "$srcdir"/glassine-clock.initd "$pkgdir"/etc/init.d/glassine-clock
	install -Dm755 "$srcdir"/glassine-splash.initd "$pkgdir"/etc/init.d/glassine-splash
	install -Dm755 "$srcdir"/onyx-noteair-tune.initd "$pkgdir"/etc/init.d/onyx-noteair-tune
	install -Dm755 "$srcdir"/onyx-noteair-bringup "$pkgdir"/usr/sbin/onyx-noteair-bringup
	install -Dm755 "$srcdir"/onyx-noteair-bringup.initd "$pkgdir"/etc/init.d/onyx-noteair-bringup
	install -Dm644 "$srcdir"/onyx-noteair-bringup.modprobe "$pkgdir"/etc/modprobe.d/onyx-noteair-bringup.conf
	install -Dm644 "$srcdir"/glassine-session.confd "$pkgdir"/etc/conf.d/glassine-session
	install -Dm755 "$srcdir"/glassine-clock.nm-dispatcher \
		"$pkgdir"/etc/NetworkManager/dispatcher.d/50-glassine-clock
	install -Dm644 "$srcdir"/splash.pgm "$pkgdir"/usr/share/glassine/splash.pgm
}
