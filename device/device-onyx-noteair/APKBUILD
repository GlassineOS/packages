# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# The Onyx Boox Note Air's system services and scripts. Its configuration files
# (sysctl, sound routing) are in the device stage of GlassineOS/images.
pkgname=device-onyx-noteair
pkgver=1
pkgrel=0
builddir="$srcdir"
pkgdesc="Onyx Boox Note Air: clock, power modes, e-ink splash, boot tuning"
url="https://github.com/GlassineOS/packages"
arch="noarch"
license="GPL-2.0-or-later"
depends="busybox glassine-epdd"
source="glassine-clock
	glassine-clock.initd
	glassine-clock.nm-dispatcher
	glassine-ddr
	glassine-session.confd
	glassine-splash.initd
	onyx-noteair-tune.initd
	"

build() {
	# the splash: a white page at the panel's size (portrait, 8-bit grey)
	{ printf 'P5\n1404 1872\n255\n'; head -c $((1404 * 1872)) /dev/zero | tr '\0' '\377'; } > "$srcdir"/splash.pgm
}

check() {
	local f t rc
	for f in glassine-clock glassine-clock.initd glassine-clock.nm-dispatcher glassine-ddr \
		glassine-session.confd glassine-splash.initd onyx-noteair-tune.initd; do
		sh -n "$srcdir/$f" || return 1
	done
	t="$srcdir/t"; rm -rf "$t"; mkdir -p "$t/p" "$t/cg" "$t/pip"

	# the clock: the offset is system time - RTC
	echo 1000 > "$t/rtc"
	GLASSINE_CLOCK_RTC="$t/rtc" GLASSINE_CLOCK_OFFSET="$t/off" sh "$srcdir/glassine-clock" save
	[ $(( $(date +%s) - 1000 - $(cat "$t/off") )) -le 2 ] || { echo "clock: offset $(cat "$t/off")"; return 1; }

	# the power modes against stand-in sysfs files
	for f in ddr_table ddr_min_kbps ddr_max_kbps; do : > "$t/p/$f"; done
	: > "$t/cg/cpu.uclamp.min"; : > "$t/pip/pip"
	ddr() {
		GLASSINE_DDR_PARAMS="$t/p" GLASSINE_UCLAMP_CG="$t/cg" GLASSINE_PIP_GLOB="$t/pip/pip" \
		GLASSINE_EPDD_CTL="$t/ctl" GLASSINE_DDR_SAVED="$t/ddr" sh "$srcdir/glassine-ddr" "$@" 2>/dev/null
	}
	[ "$(ddr)" = performance ] || { echo "ddr: no saved mode is not performance"; return 1; }
	[ "$(cat "$t/p/ddr_table") $(cat "$t/p/ddr_min_kbps") $(cat "$t/cg/cpu.uclamp.min")" = "cmax 5163000 60" ] \
		|| { echo "ddr: performance applied wrong"; return 1; }
	ddr saver >/dev/null
	[ "$(cat "$t/ddr") $(cat "$t/p/ddr_table") $(cat "$t/p/ddr_min_kbps") $(cat "$t/cg/cpu.uclamp.min")" = "saver stock 0 0" ] \
		|| { echo "ddr: saver not saved or applied"; return 1; }
	[ "$(ddr epdd-opts)" = boost=0 ] || { echo "ddr: saver keeps the boost"; return 1; }
	ddr balanced >/dev/null
	[ "$(ddr epdd-opts)" = boost=150 ] && [ "$(cat "$t/p/ddr_table")" = cmax ] || { echo "ddr: balanced"; return 1; }
	echo nonsense > "$t/ddr"
	[ "$(ddr)" = performance ] || { echo "ddr: an unknown saved mode is not performance"; return 1; }
	rc=0; ddr fast >/dev/null || rc=$?
	[ $rc = 2 ] || { echo "ddr: an unknown level is accepted"; return 1; }
	rm "$t/p/ddr_table"
	ddr saver >/dev/null; [ "$(cat "$t/p/ddr_max_kbps")" = 2086000 ] || { echo "ddr: no table, no cap"; return 1; }
	rm "$t/p/ddr_min_kbps"
	rc=0; ddr >/dev/null || rc=$?
	[ $rc = 1 ] || { echo "ddr: no voter is not an error"; return 1; }
	[ "$(cat "$t/cg/cpu.uclamp.min")" = 0 ] || { echo "ddr: no voter, no floor"; return 1; }
}

package() {
	install -Dm755 "$srcdir"/glassine-clock "$pkgdir"/usr/sbin/glassine-clock
	install -Dm755 "$srcdir"/glassine-ddr "$pkgdir"/usr/sbin/glassine-ddr
	install -Dm755 "$srcdir"/glassine-clock.initd "$pkgdir"/etc/init.d/glassine-clock
	install -Dm755 "$srcdir"/glassine-splash.initd "$pkgdir"/etc/init.d/glassine-splash
	install -Dm755 "$srcdir"/onyx-noteair-tune.initd "$pkgdir"/etc/init.d/onyx-noteair-tune
	install -Dm644 "$srcdir"/glassine-session.confd "$pkgdir"/etc/conf.d/glassine-session
	install -Dm755 "$srcdir"/glassine-clock.nm-dispatcher \
		"$pkgdir"/etc/NetworkManager/dispatcher.d/50-glassine-clock
	install -Dm644 "$srcdir"/splash.pgm "$pkgdir"/usr/share/glassine/splash.pgm
}
