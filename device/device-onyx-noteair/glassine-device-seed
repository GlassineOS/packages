#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# glassine-device-seed: files that only the device itself has (the panel's
# waveform), copied once from the device's own storage into a seed and read
# from there afterwards (GlassineOS/boot docs/kernel-artifacts.md, "Device
# data").
#
#   glassine-device-seed            verify the seed, copy what's missing or wrong,
#                                   bind it read-only on /run/glassine/device
#   glassine-device-seed refresh    copy every file again from its source
#   glassine-device-seed status     what the seed holds; exit 0 = complete
#
# The seed is glassine/ on DEVICE_PART: a manifest (format=1, then one line per
# file: name, source, sha256), the files next to it. The list of files and
# their sources is in /etc/glassine/device-seed.conf. Sources are read
# read-only (ext4 with debugfs, no mount; vfat ro; btrfs ro,rescue=nologreplay)
# and never written. DEVICE_PART is ext4: its journal is replayed by one
# read-write mount if it needs recovery, it is mounted read-write only while
# files are written (temp files, renamed, the manifest last) and otherwise
# ro,noload. Nothing is bound unless every file in the manifest matches.
# Exit: 0 complete, 1 incomplete (what there is is bound), 2 usage or config.
set -u

CONF=${GLASSINE_SEED_CONF:-/etc/glassine/device-seed.conf}
RUN=${GLASSINE_SEED_RUN:-/run/glassine}
# tests: a directory stands in for the partitions. $FAKE/part is DEVICE_PART's
# file system, $FAKE/src/PART/PATH the sources; binding becomes a symlink
FAKE=${GLASSINE_SEED_FAKE:-}
SEED=$RUN/device
MNT=$RUN/device-part

say() {
	echo "glassine-device-seed: $*" >&2
	{ [ -w /dev/kmsg ] && echo "<5>glassine-device-seed: $*" > /dev/kmsg; } 2>/dev/null
}

DEVICE_PART=
ENTRIES=
read_conf() {
	[ -r "$CONF" ] || { say "no $CONF"; exit 2; }
	local l
	while IFS= read -r l || [ -n "$l" ]; do
		l=${l%%#*}
		set -- $l
		[ $# -gt 0 ] || continue
		case $1 in
		DEVICE_PART=*) DEVICE_PART=${1#DEVICE_PART=} ;;
		*)	[ $# -ge 2 ] || { say "$CONF: '$l': name and source needed"; exit 2; }
			case $1 in */*|.*) say "$CONF: '$1' is not a plain file name"; exit 2 ;; esac
			case $2 in *:/*) ;; *) say "$CONF: '$2' is not PART:/PATH"; exit 2 ;; esac
			ENTRIES="$ENTRIES$1 $2 ${3:-none}
" ;;
		esac
	done < "$CONF"
	[ -n "$DEVICE_PART" ] || { say "$CONF: no DEVICE_PART"; exit 2; }
	[ -n "$ENTRIES" ] || { say "$CONF: no files"; exit 2; }
}

# the device node of a GPT partition name, from sysfs (no udev links this early)
part_dev() {
	local u
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTNAME=$1" "$u" 2>/dev/null || continue
		echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"
		return 0
	done
	return 1
}

# CHECK FILE: the file looks like what it should be
check_file() {
	local n
	n=$(wc -c < "$2" 2>/dev/null) || return 1
	[ "$n" -gt 0 ] || return 1
	case $1 in
	none) return 0 ;;
	# an E Ink waveform: a header (0x100 bytes or more) whose length field
	# (offset 4, 32 bits, little-endian) is the file's size
	wbf) [ "$n" -ge 256 ] && [ "$(od -A n -t u4 -j 4 -N 4 "$2" | tr -d ' ')" = "$n" ] ;;
	*) say "unknown check '$1'"; return 1 ;;
	esac
}

# the file system type of DEV, from blkid's default output (DEV: ... TYPE="ext4"
# ...). Busybox blkid ignores -o and -s, so they aren't used; the space before
# TYPE= keeps SEC_TYPE= and PTTYPE= (util-linux) out.
fs_type() {
	blkid "$1" 2>/dev/null | sed -n 's/.*[[:space:]]TYPE="\([^"]*\)".*/\1/p' | head -n1
}

# read_source PART:/PATH OUT: copy one file from a source, read-only
read_source() {
	local part=${1%%:*} path=${1#*:} dev t m rc=1
	if [ -n "$FAKE" ]; then dev=$FAKE/src/$part
	else dev=$(part_dev "$part") || { say "no partition $part"; return 1; }
	fi
	t=$(fs_type "$dev")
	case $t in
	ext2|ext3|ext4|vfat|btrfs) ;;
	*) say "$part: file system '${t:-unknown}' not read"; return 1 ;;
	esac
	if [ -n "$FAKE" ]; then
		cp "$dev$path" "$2" 2>/dev/null
		return
	fi
	case $t in
	ext*)
		debugfs -R "dump -p $path $2" "$dev" >/dev/null 2>&1
		[ -s "$2" ] ;;
	*)
		m=$RUN/device-src; mkdir -p "$m"
		if [ "$t" = btrfs ]; then mount -t btrfs -o ro,rescue=nologreplay "$dev" "$m"
		else mount -t vfat -o ro "$dev" "$m"; fi || return 1
		cp "$m$path" "$2" 2>/dev/null && rc=0
		umount "$m"
		return $rc ;;
	esac
}

# DEVICE_PART mounted (MODE ro or rw) on $MNT
DEV=
part_mount() {
	if [ -n "$FAKE" ]; then
		mkdir -p "$FAKE/part"; rm -f "$MNT"; ln -s "$FAKE/part" "$MNT"
		return
	fi
	mkdir -p "$MNT"
	if [ "$1" = rw ]; then mount -t ext4 -o rw,noatime "$DEV" "$MNT"
	else mount -t ext4 -o ro,noload "$DEV" "$MNT"; fi
}
part_umount() {
	if [ -n "$FAKE" ]; then rm -f "$MNT"; return; fi
	! mountpoint -q "$MNT" || umount "$MNT"
}
bound() {
	if [ -n "$FAKE" ]; then [ -L "$SEED" ]; else mountpoint -q "$SEED"; fi
}
bind_seed() {
	if [ -n "$FAKE" ]; then rm -f "$SEED"; ln -s "$MNT/glassine" "$SEED"; return; fi
	mkdir -p "$SEED"
	mount -o bind "$MNT/glassine" "$SEED" && mount -o remount,bind,ro "$SEED"
}
unbind_seed() {
	if [ -n "$FAKE" ]; then rm -f "$SEED"; return; fi
	! mountpoint -q "$SEED" || umount "$SEED"
}

# DEVICE_PART mounted anywhere but $MNT (another tool's mount): no rw mount then
mounted_elsewhere() {
	[ -n "$FAKE" ] && return 1
	local want src mp rest
	want=$(stat -L -c %t:%T "$DEV")
	while read -r src mp rest; do
		case $src in /dev/*) ;; *) continue ;; esac
		[ "$mp" = "$MNT" ] && continue
		[ "$(stat -L -c %t:%T "$src" 2>/dev/null)" = "$want" ] && return 0
	done < /proc/mounts
	return 1
}

needs_recovery() {
	[ -n "$FAKE" ] && { [ -e "$FAKE/needs_recovery" ]; return; }
	dumpe2fs -h "$DEV" 2>/dev/null | grep -q '^Filesystem features:.*needs_recovery'
}

# the manifest's line for NAME (name source sha256), empty if none
man_line() {
	[ -r "$MNT/glassine/manifest" ] || return 0
	awk -v n="$1" 'NR > 1 && $1 == n' "$MNT/glassine/manifest"
}
# NAME SOURCE: the seed's copy is the manifest's, from the same source
seed_ok() {
	local l
	l=$(man_line "$1")
	[ -n "$l" ] || return 1
	set -- $l "$2"
	[ "$2" = "$4" ] && [ -f "$MNT/glassine/$1" ] &&
		[ "$(sha256sum "$MNT/glassine/$1" | cut -d' ' -f1)" = "$3" ]
}
# every file of the manifest matches (whatever the list says)
manifest_ok() {
	local f n s h
	f=$MNT/glassine/manifest
	[ "$(head -n1 "$f" 2>/dev/null)" = format=1 ] || return 1
	tail -n +2 "$f" | {
		while read -r n s h; do
			[ "$(sha256sum "$MNT/glassine/$n" 2>/dev/null | cut -d' ' -f1)" = "$h" ] || exit 1
		done
	}
}
# every file of the list is in the manifest, from its source, and matches
seed_complete() {
	local n s c
	manifest_ok || return 1
	echo "$ENTRIES" | while read -r n s c; do
		[ -n "$n" ] || continue
		seed_ok "$n" "$s" || exit 1
	done
}

# copy what's missing or wrong (FORCE=1: everything), the manifest last
seed() {
	local force=$1 tmp n s c keep="" fresh="" missing="" unread="" l
	tmp=$RUN/device-seed.tmp
	rm -rf "$tmp"; mkdir -p "$tmp" || return 1
	# what stays and what is read again, before anything is written
	while read -r n s c; do
		[ -n "$n" ] || continue
		if [ "$force" != 1 ] && seed_ok "$n" "$s"; then
			keep="$keep $n"
		elif read_source "$s" "$tmp/$n" && check_file "$c" "$tmp/$n"; then
			fresh="$fresh $n"
		elif seed_ok "$n" "$s"; then
			say "$n: could not be read from $s; the seed's copy stays"
			rm -f "$tmp/$n"
			keep="$keep $n" unread="$unread $n"
		else
			say "$n: could not be read from $s"
			rm -f "$tmp/$n"
			missing="$missing $n"
		fi
	done <<EOF
$ENTRIES
EOF
	if [ -z "$fresh" ] && manifest_ok && [ -n "$keep" ]; then
		rm -rf "$tmp"
		[ -z "$missing$unread" ]; return
	fi
	[ -n "$fresh" ] || [ -n "$keep" ] || { rm -rf "$tmp"; return 1; }
	# the manifest: kept lines as they were, new ones with their hash
	{
		echo format=1
		for n in $keep; do man_line "$n"; done
		while read -r n s c; do
			[ -n "$n" ] || continue
			case " $fresh " in *" $n "*) ;; *) continue ;; esac
			echo "$n $s $(sha256sum "$tmp/$n" | cut -d' ' -f1)"
		done <<EOF
$ENTRIES
EOF
	} > "$tmp/manifest.new"
	part_umount
	if mounted_elsewhere; then
		say "$DEVICE_PART is mounted elsewhere; not writing the seed"
		rm -rf "$tmp"; part_mount ro; return 1
	fi
	part_mount rw || { say "cannot mount $DEVICE_PART read-write"; rm -rf "$tmp"; return 1; }
	(
		mkdir -p "$MNT/glassine" || exit 1
		for n in $fresh; do
			cp "$tmp/$n" "$MNT/glassine/.$n.new" && sync && mv -f "$MNT/glassine/.$n.new" "$MNT/glassine/$n" || exit 1
		done
		cp "$tmp/manifest.new" "$MNT/glassine/.manifest.new" && sync &&
			mv -f "$MNT/glassine/.manifest.new" "$MNT/glassine/manifest" && sync
	)
	l=$?
	# files the list no longer names
	for n in "$MNT"/glassine/*; do
		[ -f "$n" ] || continue
		case $n in */manifest) continue ;; esac
		grep -q "^${n##*/} " "$tmp/manifest.new" || rm -f "$n"
	done
	sync
	part_umount; rm -rf "$tmp"
	[ $l = 0 ] || { say "writing the seed failed"; part_mount ro; return 1; }
	part_mount ro || return 1
	[ -n "$fresh" ] && say "seeded:$fresh"
	[ -z "$missing$unread" ]
}

status() {
	local n s c
	while read -r n s c; do
		[ -n "$n" ] || continue
		if seed_ok "$n" "$s"; then echo "$n ok ($s)"; else echo "$n missing ($s)"; fi
	done <<EOF
$ENTRIES
EOF
	seed_complete
}

main() {
	local verb=${1:-start} rc=0
	case $verb in start|refresh|status) ;; *) echo "usage: glassine-device-seed [refresh|status]" >&2; exit 2 ;; esac
	read_conf
	if [ -z "$FAKE" ]; then
		DEV=$(part_dev "$DEVICE_PART") || { say "no partition $DEVICE_PART"; exit 1; }
	fi
	mkdir -p "$RUN"
	if [ "$verb" = status ]; then
		if bound; then
			[ -n "$FAKE" ] || mountpoint -q "$MNT" || { echo "bound, $MNT not mounted"; exit 1; }
			status; exit
		fi
		part_mount ro || exit 1; status; rc=$?; part_umount; exit $rc
	fi
	if [ "$verb" = start ] && bound; then exit 0; fi
	unbind_seed; part_umount
	if needs_recovery; then
		if mounted_elsewhere; then say "$DEVICE_PART's journal needs recovery, but it is mounted elsewhere"; exit 1; fi
		say "replaying $DEVICE_PART's journal"
		part_mount rw && part_umount || { say "cannot replay $DEVICE_PART's journal"; exit 1; }
		[ -z "$FAKE" ] || rm -f "$FAKE/needs_recovery"
	fi
	part_mount ro || { say "cannot mount $DEVICE_PART"; exit 1; }
	if [ "$verb" = refresh ] || ! seed_complete; then
		seed "$([ "$verb" = refresh ] && echo 1)" || rc=1
	fi
	if manifest_ok; then
		bind_seed || { say "cannot bind the seed"; exit 1; }
	else
		part_umount; rc=1
	fi
	exit $rc
}

main "$@"
