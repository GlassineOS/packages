#!/bin/sh
# Hibernation hook (glassine-hibernate, pre/post): after a restore on a machine
# that was off, the PMIC's ADC and temperature alarms raise interrupts without
# end. Detach their drivers before the hibernation and attach them again after.
MARK=/run/glassine-hibernate-pmic
set -- "$1" \
    /sys/bus/platform/drivers/qcom-spmi-adc5:800f000.spmi:pmic@0:adc@3100 \
    /sys/bus/platform/drivers/spmi-temp-alarm:800f000.spmi:pmic@0:temp-alarm@2400 \
    /sys/bus/platform/drivers/spmi-temp-alarm:800f000.spmi:pmic@2:temp-alarm@2400
op=$1; shift
case $op in
pre)
    : > "$MARK"
    for e; do
        drv=${e%%:*} dev=${e#*:}
        [ -e "$drv/$dev" ] && echo "$dev" > "$drv/unbind" && echo "$e" >> "$MARK"
    done ;;
post)
    [ -e "$MARK" ] || exit 0
    while read -r e; do
        drv=${e%%:*} dev=${e#*:}
        [ -e "$drv/$dev" ] || echo "$dev" > "$drv/bind"
    done < "$MARK"
    rm -f "$MARK" ;;
esac
exit 0
