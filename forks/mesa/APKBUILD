# --- GlassineOS: subpackages of drivers not built stay as EMPTY packages ---
_glassine_empty() {
	pkgdesc="$pkgdesc (GlassineOS build: empty, driver not built)"
	depends="mesa=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"
}
_va() { _glassine_empty; }
_vdpau() { _glassine_empty; }
_vulkan() { _glassine_empty; }
_vulkan_layers() { pkgdesc="collection of vulkan layers from mesa"; _glassine_empty; depends=""; }
libd3dadapter9() { _glassine_empty; }
rusticl() { _glassine_empty; }
