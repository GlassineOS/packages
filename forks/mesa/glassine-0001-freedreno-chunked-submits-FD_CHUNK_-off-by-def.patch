+/* chunked submits: chunked submits.  A long sysmem batch is cut into several kernel
+ * submits (chunks) so the CP has a yield point every few GPU-ms: the e-ink
+ * engine's high-priority ring gets the GPU within one chunk instead of
+ * within one app frame.  Default off.  Env:
+ *   FD_CHUNK_US=<n>     cut when the estimated GPU time of the open chunk
+ *                       would pass n us (0 = off)
+ *   FD_CHUNK_DRAWS=<n>  cut after n draws (0 = off); either or both
+ *   FD_CHUNK_COST=<draw_ns>,<vert_ps>  the estimate: a fixed cost per draw
+ *                       in ns plus a per-vertex cost in ps (defaults 20000,
+ *                       10000: 20 us + 0.01 us/vertex; calibrate on the
+ *                       device from the longest-submit measurement)
+ *   FD_CHUNK_ADAPT=0    turn the self-calibration off (default on when
+ *                       FD_CHUNK_US is set): the estimate is scaled per
+ *                       context by measured_ns / estimated_ns of the chunks
+ *                       and whole batches already run, from GPU timestamps
+ *                       (see fd_batch_chunk_ts_begin()); with the scale a
+ *                       chunk is ~FD_CHUNK_US of GPU time whatever the app's
+ *                       draws cost, so an app with cheap draws cuts rarely.
+ *   FD_CHUNK_BUSY=<on>,<off>  the busy gate (with FD_CHUNK_ADAPT; default
+ *                       75,60; 0 = always cut): a context cuts only while
+ *                       its own GPU work (estimate x scale) fills >= <on> %
+ *                       of the wall time, and stops below <off> %.  A light
+ *                       app leaves the GPU idle half the time, so the e-ink
+ *                       engine's ring gets in between its submits anyway;
+ *                       there the cuts are pure cost (OpenMW 0.47: 75 -> 57
+ *                       fps, and the panel engine missed no frame either way).
+ *   FD_CHUNK_NOMERGE=1  (drm layer) one ioctl per gallium batch, no merging
+ *                       of deferred submits
+ */
+struct fd_chunk_config {
+   bool enabled;
+   bool adapt;
+   uint32_t budget_us;
+   uint32_t max_draws;
+   uint32_t draw_ns;
+   uint32_t vert_ps;
+   /* FD_CHUNK_BUSY: the busy gate's on/off thresholds, percent (0 = off) */
+   uint32_t busy_on, busy_off;
+};
+extern struct fd_chunk_config fd_chunk;
+
 #include <unistd.h>
 #include <sys/types.h>
 #include <sys/syscall.h>
@@ -376,6 +417,18 @@ __OUT_IB5(struct fd_ringbuffer *ring, struct fd_ringbuffer *target)
