--- a/src/freedreno/drm/freedreno_ringbuffer.h
+++ b/src/freedreno/drm/freedreno_ringbuffer.h
@@ -106,6 +106,26 @@ struct fd_ringbuffer_funcs {
    uint32_t (*cmd_count)(struct fd_ringbuffer *ring);
    bool (*check_size)(struct fd_ringbuffer *ring);
    void (*destroy)(struct fd_ringbuffer *ring);
+
+   /**
+    * chunked submits: close the current cmdstream buffer of a
+    * growable ring and start a new one, so that cmd_count() grows by one
+    * and the two parts can be referenced (emit_reloc_ring) or submitted
