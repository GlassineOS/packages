    ring->size = size;
 }
 
+/* chunked submits: like grow, but the closed cmd is marked as the end of a submit
+ * group.  An empty current cmd is not closed (nothing to split).
+ */
+static void
+fd_ringbuffer_sp_split(struct fd_ringbuffer *ring)
+{
+   struct fd_ringbuffer_sp *fd_ring = to_fd_ringbuffer_sp(ring);
+
+   assert(ring->flags & FD_RINGBUFFER_GROWABLE);
+   assert(!(ring->flags & _FD_RINGBUFFER_OBJECT));
+
+   if (ring->cur == ring->start) {
+      /* mark the previous cmd instead, if there is one: */
+      if (fd_ring->u.nr_cmds)
+         fd_ring->u.cmds[fd_ring->u.nr_cmds - 1].split_after = true;
+      return;
+   }
+
+   fd_ringbuffer_sp_grow(ring, ring->size);
+   fd_ring->u.cmds[fd_ring->u.nr_cmds - 1].split_after = true;
+}
+
+/* chunked submits: see fd_ringbuffer_funcs::cmd_info.  Same cmd addressing as
+ * find_target_bo(): cmd_idx == nr_cmds is the open cmd.
+ */
+static uint32_t
+fd_ringbuffer_sp_cmd_info(struct fd_ringbuffer *ring, uint32_t cmd_idx,
+                          bool *split_after)
+{
+   struct fd_ringbuffer_sp *fd_ring = to_fd_ringbuffer_sp(ring);
+
+   assert(!(ring->flags & _FD_RINGBUFFER_OBJECT));
+
+   if ((ring->flags & FD_RINGBUFFER_GROWABLE) &&
+       (cmd_idx < fd_ring->u.nr_cmds)) {
+      *split_after = fd_ring->u.cmds[cmd_idx].split_after;
+      return fd_ring->u.cmds[cmd_idx].size;
+   }
+
+   *split_after = false;
+   return offset_bytes(ring->cur, ring->start);
+}
+
