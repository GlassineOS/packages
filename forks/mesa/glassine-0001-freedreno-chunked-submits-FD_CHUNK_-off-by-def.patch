+/* chunked submits: FD_CHUNK_NOMERGE=1 makes every deferred submit
+ * (= every gallium batch) its own ioctl instead of merging them into one.
+ * Merged submits run as one GPU job (the kernel yields only at the end of a
+ * submit), so with FD_MESA_DEBUG=flush the merged offscreen batches were
+ * still 20-30 ms jobs on the A509.  The CPU-side
+ * batching of the ioctls (one wakeup of the submit thread) is kept.
+ */
+static bool
+chunk_nomerge(void)
+{
+   static int val = -1;
+   if (val < 0)
+      val = debug_get_bool_option("FD_CHUNK_NOMERGE", false) ? 1 : 0;
+   return val;
+}
