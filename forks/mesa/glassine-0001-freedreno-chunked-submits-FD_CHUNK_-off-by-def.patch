+    * a kernel-submit boundary: the backend issues one ioctl per group of
+    * cmds, which gives the CP a yield point between them.  Optional (NULL
+    * if the backend does not support it).
+    */
+   void (*split)(struct fd_ringbuffer *ring);
+
+   /**
+    * chunked submits: size in bytes of cmd `cmd_idx` of a growable ring (the open,
+    * unfinished cmd included) and whether a split() boundary follows it.
+    * A growable ring also starts a new cmd whenever a buffer fills up
+    * (grow); only the split() boundaries are chunk boundaries.  Optional.
+    */
+   uint32_t (*cmd_info)(struct fd_ringbuffer *ring, uint32_t cmd_idx,
+                        bool *split_after);
 };
 
 /* the ringbuffer object is not opaque so that OUT_RING() type stuff
@@ -183,6 +203,30 @@ fd_ringbuffer_check_size(struct fd_ringbuffer *ring)
    return ring->funcs->check_size(ring);
 }
 
+/* chunked submits: see fd_ringbuffer_funcs::split.  Returns false if unsupported. */
+static inline bool
+fd_ringbuffer_split(struct fd_ringbuffer *ring)
+{
+   if (!ring->funcs->split || !(ring->flags & FD_RINGBUFFER_GROWABLE))
+      return false;
+   ring->funcs->split(ring);
+   return true;
+}
+
+/* chunked submits: see fd_ringbuffer_funcs::cmd_info.  Without backend support the
+ * cmd counts as non-empty and not followed by a split.
+ */
+static inline uint32_t
+fd_ringbuffer_cmd_info(struct fd_ringbuffer *ring, uint32_t cmd_idx,
+                       bool *split_after)
+{
+   if (!ring->funcs->cmd_info) {
+      *split_after = false;
+      return ~0u;
+   }
+   return ring->funcs->cmd_info(ring, cmd_idx, split_after);
+}
