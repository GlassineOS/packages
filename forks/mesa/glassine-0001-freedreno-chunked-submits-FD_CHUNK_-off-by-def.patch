-   int ret;
+   int ret = 0;
 
    unsigned nr_cmds = 0;
 
@@ -41,6 +59,9 @@ flush_submit_list(struct list_head *submit_list)
    }
 
    struct drm_msm_gem_submit_cmd cmds[nr_cmds];
+   /* chunked submits: split_after[i] -> a new ioctl starts after cmds[i] */
+   bool split_after[nr_cmds];
+   unsigned nr_groups = 1;
 
    unsigned cmd_idx = 0;
 
@@ -60,6 +81,12 @@ flush_submit_list(struct list_head *submit_list)
          cmds[cmd_idx].pad = 0;
          cmds[cmd_idx].nr_relocs = 0;
 
+         /* chunked submits: a split inside the batch, or (FD_CHUNK_NOMERGE) the end
+          * of this deferred submit:
+          */
+         bool last_of_submit = (i == deferred_primary->u.nr_cmds - 1);
+         split_after[cmd_idx] = deferred_primary->u.cmds[i].split_after ||
+                                (last_of_submit && chunk_nomerge());
          cmd_idx++;
       }
 
@@ -124,22 +151,54 @@ flush_submit_list(struct list_head *submit_list)
 
    req.bos = VOID2U64(submit_bos);
    req.nr_bos = fd_submit->nr_bos;
-   req.cmds = VOID2U64(cmds);
-   req.nr_cmds = nr_cmds;
-
-   DEBUG_MSG("nr_cmds=%u, nr_bos=%u", req.nr_cmds, req.nr_bos);
-
-   ret = drmCommandWriteRead(pipe->dev->fd, DRM_MSM_GEM_SUBMIT, &req,
-                             sizeof(req));
-   if (ret) {
-      ERROR_MSG("submit failed: %d (%s)", ret, strerror(errno));
-      msm_dump_submit(&req);
-   } else if (!ret) {
-      fd_submit->out_fence->kfence = req.fence;
-      fd_submit->out_fence->fence_fd = req.fence_fd;
-   }
 
-   msm_dump_rd(pipe, &req);
+   /* chunked submits: the last cmd never starts a new group; count the groups. */
+   if (nr_cmds)
+      split_after[nr_cmds - 1] = false;
+   for (unsigned i = 0; i < nr_cmds; i++)
+      nr_groups += split_after[i];
+
+   /* One ioctl per group, all on the same submitqueue (so in order, and
+    * the kernel's own fences stay monotonic).  Every group lists the whole
+    * bo table: simpler than tracking per-group use, and the implicit-sync
+    * fences it adds are redundant, not wrong.  The in-fence gates only the
+    * first group (the later ones follow it on the queue anyway); the
+    * out-fence is the last group's.
+    */
+   unsigned first = 0;
+   for (unsigned g = 0; g < nr_groups && !ret; g++) {
+      unsigned last = first;
+      while (last + 1 < nr_cmds && !split_after[last])
+         last++;
+
+      struct drm_msm_gem_submit greq = req;
+      greq.cmds = VOID2U64(&cmds[first]);
+      greq.nr_cmds = nr_cmds ? last - first + 1 : 0;
+      if (g > 0) {
+         greq.flags &= ~MSM_SUBMIT_FENCE_FD_IN;
+         greq.fence_fd = 0;
+      }
+      if (g + 1 < nr_groups)
+         greq.flags &= ~MSM_SUBMIT_FENCE_FD_OUT;
+
+      DEBUG_MSG("nr_cmds=%u, nr_bos=%u (group %u/%u)", greq.nr_cmds,
+                greq.nr_bos, g + 1, nr_groups);
+
+      ret = drmCommandWriteRead(pipe->dev->fd, DRM_MSM_GEM_SUBMIT, &greq,
+                                sizeof(greq));
+      if (ret) {
+         ERROR_MSG("submit failed: %d (%s)", ret, strerror(errno));
+         msm_dump_submit(&greq);
+      } else {
+         fd_submit->out_fence->kfence = greq.fence;
+         if (g + 1 == nr_groups)
+            fd_submit->out_fence->fence_fd = greq.fence_fd;
+      }
+
+      msm_dump_rd(pipe, &greq);
+
+      first = last + 1;
+   }
 
    if (!bos_on_stack)
       free(submit_bos);
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c b/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c
index 2f4a9e2a097..b6407fee0ef 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_gmem.c
@@ -695,6 +695,24 @@ fd5_emit_tile_fini(struct fd_batch *batch) assert_dt
    fd5_set_render_mode(batch->ctx, ring, BYPASS);
 }
 
+/* FD_CHUNK_ADAPT: a 64-bit GPU timestamp (the 19.2 MHz always-on
+ * counter, as the timestamp queries use it: fd5_query.c timestamp_resume)
+ * into ctx->chunk_adapt.bo at `offset`.  RB_DONE_TS is written once the RB
+ * has retired everything before it.  5 dwords.
+ */
+static void
+fd5_emit_chunk_ts(struct fd_batch *batch, struct fd_ringbuffer *ring,
+                  uint32_t offset)
+{
+   OUT_PKT7(ring, CP_EVENT_WRITE, 4);
+   OUT_RING(ring,
+            CP_EVENT_WRITE_0_EVENT(RB_DONE_TS) | CP_EVENT_WRITE_0_TIMESTAMP);
+   OUT_RELOC(ring, batch->ctx->chunk_adapt.bo, offset, 0, 0);
+   OUT_RING(ring, 0x00000000);
+
+   fd_reset_wfi(batch);
+}
+
