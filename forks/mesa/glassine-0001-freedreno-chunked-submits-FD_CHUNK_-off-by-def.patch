+/* chunked submits: chunked submits.
+ *
+ * A chunk boundary is a batch boundary as far as the GPU is concerned: the
+ * current chunk ends with the gen's sysmem_fini (CCU flush), the next one
+ * starts with sysmem_prep (fd5_emit_restore: render mode, UCHE invalidate,
+ * the per-batch invariants, the render target) and the next draw re-emits
+ * the complete draw state (fd_context_all_dirty), exactly as the first draw
+ * of a fresh batch does.  So no GPU state is assumed to survive the yield
+ * point between two chunks, whatever ran on the GPU in between.
+ *
+ * What does carry over is the batch's CPU-side bookkeeping: one submit,
+ * one fence, one resource-tracking set, one framebuffer state.  That is the
+ * saving against FD_MESA_DEBUG=flush, which ends a batch per draw and pays
+ * the batch machinery, the dependency flushes and (in GMEM) a tile resolve
+ * for every draw.
+ */
+static bool
+chunk_can_cut(struct fd_batch *batch) assert_dt
+{
+   struct fd_context *ctx = batch->ctx;
+
+   /* only the a5xx sysmem path has been looked at: */
+   if (ctx->screen->gen != 5)
+      return false;
+
+   if (batch->nondraw)
+      return false;
+
+   /* the open chunk must hold at least one draw: */
+   if (batch->chunk_draws == 0)
+      return false;
+
+   /* a hw query (occlusion, timestamp) spanning the cut would get its
+    * start and end samples from different IB2 cmds; the sample bookkeeping
+    * is per batch, so stay in one chunk while any is active:
+    */
+   if (batch->query_providers_active)
+      return false;
+   if (!list_is_empty(&ctx->acc_active_queries))
+      return false;
+
+   /* streamout offsets are tracked per draw; keep it simple: */
+   if (ctx->streamout.num_targets > 0)
+      return false;
+
+   if (!(batch->draw->flags & FD_RINGBUFFER_GROWABLE))
+      return false;
+
+   return true;
+}
+
+/* FD_CHUNK_ADAPT: self-calibration of the cost estimate.
+ *
+ * FD_CHUNK_COST is a fixed ns-per-draw + ps-per-vertex model, and real draw
+ * cost differs ~10x between apps (OpenMW 0.51's heavy draws vs 0.47's cheap
+ * ones): one constant either cuts a light app into
+ * 0.3 ms chunks (every cut pays prep/fini + an ioctl) or lets a heavy one
+ * run 20 ms chunks.  So the estimate is scaled per context by what the GPU
+ * actually took:
+ *
+ *  - Every measured segment -- a chunk, or a whole batch that was never cut
+ *    (so the estimator learns before the first cut) -- gets a slot in a
+ *    small ring bo.  The gen's sysmem_prep writes a GPU timestamp (the
+ *    19.2 MHz always-on counter, CP_EVENT_WRITE RB_DONE_TS|TIMESTAMP, as the
+ *    timestamp queries do) into slot.start after its own setup, sysmem_fini
+ *    writes slot.end before its CCU flushes: measured = the draw work.
+ *  - The CPU never waits.  A slot is pre-filled with ~0 (the counter's high
+ *    dword can't be 0xffffffff), and consumed in order only once both
+ *    stamps are written; the oldest unwritten slot stops the walk.  A full
+ *    ring (the GPU is far behind) just skips measuring the segment.
+ *  - scale = EWMA of measured / estimated in the log2 domain (ratios), rate
+ *    1/8 weighted by the segment's length so a batch of two tiny draws
+ *    moves it little; clamped to [0.1, 20].  Starts at 1 = the FD_CHUNK_COST
+ *    value.  Outlier samples (end <= start, torn read, > 1 s) are dropped.
+ *  - The cut decision uses estimate x scale, and never cuts an open chunk
+ *    whose scaled estimate is below half the budget (one over-estimated
+ *    big draw must not make two half-chunks).
+ */
+#define CHUNK_ADAPT_SLOTS 512 /* x 16 B = 8 KB bo */
+#define CHUNK_ADAPT_RATE 0.125f
+#define CHUNK_SCALE_MIN 0.1f
+#define CHUNK_SCALE_MAX 20.0f
+
+static void
+chunk_adapt_sample(struct fd_chunk_adapt *ad, uint32_t est_ns, uint64_t meas_ns)
+{
+   float budget_ns = (float)fd_chunk.budget_us * 1000.0f;
+   float r = (float)meas_ns / (float)est_ns;
+
+   r = CLAMP(r, 1.0f / 64.0f, 64.0f);
+
+   /* a segment of ~budget/2 or longer counts fully; a tiny one 1/16: */
+   float w = CLAMP((float)meas_ns / (0.5f * budget_ns), 1.0f / 16.0f, 1.0f);
+
+   ad->log2_scale += CHUNK_ADAPT_RATE * w * (log2f(r) - ad->log2_scale);
+   ad->log2_scale = CLAMP(ad->log2_scale, log2f(CHUNK_SCALE_MIN),
+                          log2f(CHUNK_SCALE_MAX));
+   ad->scale = exp2f(ad->log2_scale);
+
+   ad->samples++;
+   ad->meas_ns += meas_ns;
+   ad->est_ns += est_ns;
+}
+
+/* One stamp of a slot, ~0 if not written yet.  The slot is pre-filled with
+ * ~0 and the counter's high dword is never 0xffffffff, so a half-written
+ * (torn) read of the high dword also reads as "not yet".
+ */
+static inline uint64_t
+chunk_ts_read(struct fd_chunk_adapt *ad, unsigned slot, unsigned which)
+{
+   volatile uint64_t *ts = ad->map + slot * 2 + which;
+   uint64_t v = *ts;
+   return ((v >> 32) == 0xffffffffu) ? ~0ull : v;
+}
+
+/* Read back the finished slots (no wait: stop at the first unwritten). */
+static void
+chunk_adapt_consume(struct fd_context *ctx) assert_dt
+{
+   struct fd_chunk_adapt *ad = &ctx->chunk_adapt;
+
+   while (ad->tail != ad->head) {
+      unsigned slot = ad->tail % ad->nr_slots;
+      uint64_t start = chunk_ts_read(ad, slot, 0);
+      uint64_t end = chunk_ts_read(ad, slot, 1);
+
+      if (start == ~0ull || end == ~0ull) {
+         /* Not written yet -- unless a later slot already is: segments run
+          * in flush order on one submitqueue, so then this one's stamps
+          * were lost (GPU hang / reset) and would block the walk forever.
+          */
+         if (ad->tail + 1 != ad->head) {
+            unsigned next = (ad->tail + 1) % ad->nr_slots;
+            if (chunk_ts_read(ad, next, 0) != ~0ull &&
+                chunk_ts_read(ad, next, 1) != ~0ull) {
+               ad->tail++;
+               ad->bad++;
+               continue;
+            }
+         }
+         break;
+      }
+
+      ad->tail++;
+
+      /* end <= start or > 1 s (19.2 MHz ticks): torn read or garbage */
+      if (end <= start || end - start > 19200000ull) {
+         ad->bad++;
+         continue;
+      }
+
+      chunk_adapt_sample(ad, ad->rec[slot], ticks_to_ns(end - start));
+   }
+}
+
+static float
+chunk_scale(struct fd_context *ctx) assert_dt
+{
+   if (!fd_chunk.adapt || !ctx->chunk_adapt.samples)
+      return 1.0f;
+   return ctx->chunk_adapt.scale;
+}
+
+void
+fd_batch_chunk_ts_begin(struct fd_batch *batch, unsigned idx)
+{
+   struct fd_context *ctx = batch->ctx;
+   struct fd_chunk_adapt *ad = &ctx->chunk_adapt;
+   uint32_t est_ns = fd_batch_chunk_est_ns(batch, idx);
+
+   batch->chunk_ts_off = ~0u;
+
+   /* only the a5xx sysmem prep/fini emit the stamps; a segment with no
+    * accounted draw (clears only) teaches nothing:
+    */
+   if (!fd_chunk.adapt || ctx->screen->gen != 5 || batch->nondraw || !est_ns)
+      return;
+   if (ad->failed)
+      return;
+
+   if (!ad->bo) {
+      ad->nr_slots = CHUNK_ADAPT_SLOTS;
+      ad->bo = fd_bo_new(ctx->screen->dev, ad->nr_slots * 2 * sizeof(uint64_t),
+                         0, "chunk_ts");
+      ad->map = ad->bo ? fd_bo_map(ad->bo) : NULL;
+      ad->rec = ad->map ? calloc(ad->nr_slots, sizeof(uint32_t)) : NULL;
+      if (!ad->rec) {
+         if (ad->bo)
+            fd_bo_del(ad->bo);
+         ad->bo = NULL;
+         ad->map = NULL;
+         ad->failed = true;
+         mesa_logw("freedreno: chunked submits: no timestamp bo, adaptation off");
+         return;
+      }
+      memset(ad->map, 0xff, ad->nr_slots * 2 * sizeof(uint64_t));
+      ad->log2_scale = 0.0f;
+      ad->scale = 1.0f;
+   }
+
+   chunk_adapt_consume(ctx);
+
+   if (ad->head - ad->tail >= ad->nr_slots) {
+      ad->skipped++;
+      return;
+   }
+
+   unsigned slot = ad->head % ad->nr_slots;
+   /* consumed slots have both stamps written, so the GPU is done with it: */
+   ad->map[slot * 2] = ~0ull;
+   ad->map[slot * 2 + 1] = ~0ull;
+   ad->rec[slot] = est_ns;
+   ad->head++;
+
+   batch->chunk_ts_off = slot * 2 * sizeof(uint64_t);
+}
+
+void
+fd_batch_chunk_draw(struct fd_batch *batch, const struct pipe_draw_info *info,
+                    const struct pipe_draw_indirect_info *indirect,
+                    const struct pipe_draw_start_count_bias *draws,
+                    unsigned num_draws)
+{
+   struct fd_context *ctx = batch->ctx;
+   uint64_t verts = 0;
+
+   /* The cost estimate: a fixed cost per draw plus a per-vertex cost.
+    * Fragment work is not modelled (coverage is unknown here); the budget
+    * is a soft bound, FD_CHUNK_COST sets the model and FD_CHUNK_ADAPT
+    * scales it by what the GPU measured (see above).
+    */
+   if (!indirect) {
+      for (unsigned i = 0; i < num_draws; i++)
+         verts += draws[i].count;
+      verts *= MAX2(info->instance_count, 1);
+   }
+   uint64_t cost_ns = (uint64_t)fd_chunk.draw_ns * num_draws +
+                      (verts * fd_chunk.vert_ps) / 1000;
+   cost_ns = MIN2(cost_ns, UINT32_MAX / 2);
+
+   /* first draw of a batch: pick up finished measurements */
+   if (fd_chunk.adapt && batch->chunk_draws == 0 && ctx->chunk_adapt.bo)
+      chunk_adapt_consume(ctx);
+
+   bool cut = false;
+   /* FD_CHUNK_BUSY: a light context doesn't cut on the budget at all */
+   if (fd_chunk.budget_us && !ctx->chunk_adapt.gate_closed) {
+      float scale = chunk_scale(ctx);
+      float budget_ns = (float)fd_chunk.budget_us * 1000.0f;
+      float open_ns = (float)batch->chunk_cost_ns * scale;
+
+      if (open_ns + (float)cost_ns * scale > budget_ns &&
+          (!fd_chunk.adapt || open_ns >= 0.5f * budget_ns))
+         cut = true;
+   }
+   if (fd_chunk.max_draws && batch->chunk_draws + num_draws > fd_chunk.max_draws)
+      cut = true;
+
+   if (cut && chunk_can_cut(batch) && fd_ringbuffer_split(batch->draw)) {
+      if (!batch->chunked) {
+         batch->chunked = true;
+         batch->num_chunks = 1;
+         ctx->stats.batch_chunked++;
+      }
+      batch->num_chunks++;
+      ctx->stats.chunks++;
+      /* remember the closed chunk's estimate for the flush's measurement */
+      uint32_t *est = util_dynarray_grow(&batch->chunk_est, uint32_t, 1);
+      *est = batch->chunk_cost_ns;
+      batch->chunk_cost_ns = 0;
+      batch->chunk_draws = 0;
+
+      /* the next draw starts a new IB2 cmd: emit all state again */
+      fd_context_all_dirty(ctx);
+
+      if (fd_chunk.adapt && ctx->chunk_adapt.bo)
+         chunk_adapt_consume(ctx);
+   }
+
+   batch->chunk_cost_ns += cost_ns;
+   batch->chunk_draws += num_draws;
+}
+
+/* FD_CHUNK_BUSY: account a flushed batch's GPU work (its estimate
+ * x the learned scale) to the context's busy window, and open or close the
+ * gate.  Wall time, not GPU time: a context that keeps the GPU queued
+ * flushes at the GPU's pace, so work / wall time is its GPU share.  The
+ * gate starts open (busy 1.0), so a heavy app is chunked from its first
+ * frame; a light one stops cutting after ~0.4 s.
+ */
+#define CHUNK_BUSY_WINDOW_NS 200000000ll
+
+void
+fd_batch_chunk_account(struct fd_batch *batch)
+{
+   struct fd_context *ctx = batch->ctx;
+   struct fd_chunk_adapt *ad = &ctx->chunk_adapt;
+
+   if (!fd_chunk.busy_on || batch->nondraw)
+      return;
+
+   uint64_t est = batch->chunk_cost_ns;
+   util_dynarray_foreach (&batch->chunk_est, uint32_t, e)
+      est += *e;
+
+   int64_t now = os_time_get_nano();
+   if (!ad->win_start_ns) {
+      ad->win_start_ns = now;
+      ad->busy = 1.0f;
+   }
+   ad->win_work_ns += (uint64_t)((float)est * chunk_scale(ctx));
+   if (!batch->chunked && ad->gate_closed)
+      ad->gated_batches++;
+
+   int64_t wall_ns = now - ad->win_start_ns;
+   if (wall_ns < CHUNK_BUSY_WINDOW_NS)
+      return;
+
+   float f = MIN2((float)ad->win_work_ns / (float)wall_ns, 1.0f);
+   ad->busy = 0.5f * ad->busy + 0.5f * f;
+   ad->busy_windows++;
+   ad->win_start_ns = now;
+   ad->win_work_ns = 0;
+
+   bool closed = ad->gate_closed;
+   if (ad->busy * 100.0f >= (float)fd_chunk.busy_on)
+      closed = false;
+   else if (ad->busy * 100.0f < (float)fd_chunk.busy_off)
+      closed = true;
+   if (closed != ad->gate_closed) {
+      ad->gate_closed = closed;
+      ad->gate_flips++;
+   }
+}
