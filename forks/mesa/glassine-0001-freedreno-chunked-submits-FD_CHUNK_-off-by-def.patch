+   const char *cost = os_get_option("FD_CHUNK_COST");
+   if (cost) {
+      unsigned a, b;
+      if (sscanf(cost, "%u,%u", &a, &b) == 2) {
+         fd_chunk.draw_ns = a;
+         fd_chunk.vert_ps = b;
+      }
+   }
+   fd_chunk.enabled = fd_chunk.budget_us || fd_chunk.max_draws;
+   fd_chunk.adapt = fd_chunk.budget_us &&
+                    debug_get_bool_option("FD_CHUNK_ADAPT", true);
+   fd_chunk.busy_on = 75;
+   fd_chunk.busy_off = 60;
+   const char *busy = os_get_option("FD_CHUNK_BUSY");
+   if (busy) {
+      unsigned a, b;
+      int n = sscanf(busy, "%u,%u", &a, &b);
+      if (n == 2 && a > 0 && b <= a) {
+         fd_chunk.busy_on = a;
+         fd_chunk.busy_off = b;
+      } else if (n >= 1) {
+         fd_chunk.busy_on = a;
+         fd_chunk.busy_off = a;
+      }
+   }
+   if (!fd_chunk.adapt)
+      fd_chunk.busy_on = fd_chunk.busy_off = 0;
+   if (fd_chunk.enabled)
+      mesa_logi("freedreno: chunked submits: budget %u us, max %u draws, "
+                "cost %u ns/draw + %u ps/vertex, adapt %s, busy gate %u,%u",
+                fd_chunk.budget_us, fd_chunk.max_draws, fd_chunk.draw_ns,
+                fd_chunk.vert_ps, fd_chunk.adapt ? "on" : "off",
+                fd_chunk.busy_on, fd_chunk.busy_off);
 }
 
