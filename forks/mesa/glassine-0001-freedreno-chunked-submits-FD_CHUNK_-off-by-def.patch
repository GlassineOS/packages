+/* chunked submits: emit one cmd (chunk) of a growable target ring as an IB2. */
+static inline void
+__OUT_IB5_CMD(struct fd_ringbuffer *ring, struct fd_ringbuffer *target,
+              unsigned cmd_idx)
+{
+   uint32_t dwords;
+   OUT_PKT7(ring, CP_INDIRECT_BUFFER, 3);
+   dwords = fd_ringbuffer_emit_reloc_ring_full(ring, target, cmd_idx) / 4;
+   assert(dwords > 0);
+   OUT_RING(ring, dwords);
+}
