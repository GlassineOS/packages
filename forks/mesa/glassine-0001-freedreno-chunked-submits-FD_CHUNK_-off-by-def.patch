@@ -767,6 +792,12 @@ fd5_emit_sysmem_fini(struct fd_batch *batch)
 {
    struct fd_ringbuffer *ring = batch->gmem;
 
+   /* FD_CHUNK_ADAPT: end stamp, written when the RB has finished
