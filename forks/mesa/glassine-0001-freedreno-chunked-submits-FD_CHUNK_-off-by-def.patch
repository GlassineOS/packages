       fd5_emit_ib(ring, batch->prologue);
 
    OUT_PKT7(ring, CP_SKIP_IB2_ENABLE_GLOBAL, 1);
@@ -760,6 +779,12 @@ fd5_emit_sysmem_prep(struct fd_batch *batch) assert_dt
    emit_zs(ring, &pfb->zsbuf, NULL);
    emit_mrt(ring, pfb->nr_cbufs, pfb->cbufs, NULL);
    emit_msaa(ring, pfb->samples);
+
+   /* FD_CHUNK_ADAPT: start stamp of the measured segment, after
+    * the whole prep (its WFI makes this the point the draws start):
+    */
+   if (batch->chunk_ts_off != ~0u)
+      fd5_emit_chunk_ts(batch, ring, batch->chunk_ts_off);
 }
 
