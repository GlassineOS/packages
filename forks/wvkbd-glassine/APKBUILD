# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# wvkbd-glassine from GlassineOS/wvkbd (tag 0.21-glassine1, branch glassine/0.21): wvkbd
# 0.21 with themable keys (key outline, gap) and a German QWERTZ layer. Installs only
# /usr/bin/wvkbd-glassine, the keyboard the GlassineOS shell starts, so Alpine's wvkbd
# stays installable beside it.
pkgname=wvkbd-glassine
# the tag 0.21-glassine1 (ADR 0005: <upstream>-glassine<N>); apk spells the N as _p<N>
pkgver=0.21_p1
_tag=0.21-glassine1
pkgrel=0
pkgdesc="On-screen keyboard for wlroots (GlassineOS: themable keys, German layer)"
url="https://github.com/GlassineOS/wvkbd"
arch="all"
license="GPL-3.0-only"
makedepends="cairo-dev libxkbcommon-dev pango-dev wayland-dev"
options="!check" # no tests
source="wvkbd-$_tag.tar.gz::https://github.com/GlassineOS/wvkbd/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/wvkbd-$_tag"

build() {
	make wvkbd-mobintl
}

package() {
	install -Dm755 wvkbd-mobintl "$pkgdir"/usr/bin/wvkbd-glassine
}

sha512sums="
9f98e0320827d1c11c35e0fb3bc02b62d80378a56219655d1ffd0dbfcc711ba32e4f2da222a1abad2be207c483d83d9209f51ba308f6351561781dc1baa3d399  wvkbd-0.21-glassine1.tar.gz
"
