# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# wvkbd-glassine from GlassineOS/wvkbd (tag 0.21-glassine6, branch glassine/0.21): wvkbd
# 0.21 with themable keys (key outline, gap), a German QWERTZ layer, long press (the
# alternate in a key's corner), and the input method: committed text, a suggestion strip
# fed by glassine-predict when installed, keys by field purpose, and the handwriting
# paper fed by glassine-handwriting when installed. Installs only
# /usr/bin/wvkbd-glassine, the keyboard the GlassineOS shell starts, so Alpine's wvkbd
# stays installable beside it.
pkgname=wvkbd-glassine
# the tag 0.21-glassine6 (ADR 0005: <upstream>-glassine<N>); apk spells the N as _p<N>
pkgver=0.21_p6
_tag=0.21-glassine6
pkgrel=0
pkgdesc="On-screen keyboard for wlroots (GlassineOS: themable keys, long press, input method with suggestions)"
url="https://github.com/GlassineOS/wvkbd"
arch="all"
license="GPL-3.0-only"
makedepends="cairo-dev libxkbcommon-dev pango-dev wayland-dev"
checkdepends="python3"
source="wvkbd-$_tag.tar.gz::https://github.com/GlassineOS/wvkbd/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/wvkbd-$_tag"

build() {
	make wvkbd-mobintl
}

check() {
	make check
}

package() {
	install -Dm755 wvkbd-mobintl "$pkgdir"/usr/bin/wvkbd-glassine
}

sha512sums="
d42643661ac0dc867e15eb69d91dbf7eebd65c25009d65019c5f1ad8f0ff0cb3dfe5b121772d9c864af3889cdee03c0a2820107720803086b88311857745a776  wvkbd-0.21-glassine6.tar.gz
"
