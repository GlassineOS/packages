# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# wvkbd-glassine from GlassineOS/wvkbd (branch glassine/0.16): wvkbd with themable keys
# (outline, gap, pressed label, no press popup) and a German QWERTZ layer. Installs only
# /usr/bin/wvkbd-glassine, the keyboard the GlassineOS shell starts, so Alpine's wvkbd
# stays installable beside it.
pkgname=wvkbd-glassine
pkgver=0.16_git20261105
# GlassineOS/wvkbd glassine/0.16
_commit=c0ab1f86e54769fbea20692e46463426f5464f6b
pkgrel=0
pkgdesc="On-screen keyboard for wlroots (GlassineOS: themable keys, German layer)"
url="https://github.com/GlassineOS/wvkbd"
arch="all"
license="GPL-3.0-only"
makedepends="cairo-dev libxkbcommon-dev pango-dev wayland-dev"
options="!check" # no tests
source="wvkbd-$_commit.tar.gz::https://github.com/GlassineOS/wvkbd/archive/$_commit.tar.gz"
builddir="$srcdir/wvkbd-$_commit"

build() {
	make wvkbd-mobintl
}

package() {
	install -Dm755 wvkbd-mobintl "$pkgdir"/usr/bin/wvkbd-glassine
}

sha512sums="
