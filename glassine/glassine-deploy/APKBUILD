# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# glassine-deploy from GlassineOS/boot: the deployments tool, the shutdown switch, the
# boot-success step and hibernation, and glassine: the root lock and the apk wrapper
# (also installed as /usr/sbin/apk, before apk-tools' /sbin/apk on PATH; outside a
# deployment it runs apk-tools unchanged). The device package provides
# /etc/glassine/deploy.conf. The formats and exit codes are in boot's docs/deployments.md.
# Also: glassine-mount-ro (shutdown: userdata and the system partition read-only at
# power-off), the device data seed (glassine-device-seed: the device package's
# /usr/share/glassine/device-data.list, boot's docs/kernel-artifacts.md) and developer
# mode (glassine-devmode: USB networking and SSH with glassine.devmode=usb, boot's
# README). The image links the seed into sysinit and developer mode into default.
pkgname=glassine-deploy
pkgver=0.4.5
# GlassineOS/boot main
_commit=ad7f4b8bf7a7ffd30dfaa40768f503fca35a8584
pkgrel=0
pkgdesc="GlassineOS deployments: read-only bases, tried updates, reset, hibernation"
url="https://github.com/GlassineOS/boot"
arch="noarch"
license="GPL-2.0-or-later"
# debugfs and filefrag are in e2fsprogs-extra; ash, flock, awk and blkid in busybox;
# developer mode: udhcpd (busybox-extras), sshd and ssh-keygen (openssh-server, whose
# own sshd service stays off). device-onyx-noteair before 4 shipped its own
# glassine-device-seed.
depends="apk-tools busybox busybox-extras e2fsprogs e2fsprogs-extra openrc openssh-server
	!device-onyx-noteair<4"
# the tests need privileged Docker (real btrfs and overlayfs); they run in boot's CI.
# !tracedeps: no automatic provides, or /usr/sbin/apk would provide cmd:apk and
# conflict with apk-tools (scripts only: the depends above are complete)
options="!check !tracedeps"
subpackages="$pkgname-doc"
install="$pkgname.post-install $pkgname.pre-deinstall"
source="boot-$_commit.tar.gz::https://github.com/GlassineOS/boot/archive/$_commit.tar.gz"
builddir="$srcdir/boot-$_commit"

package() {
	local f
	for f in glassine glassine-deploy glassine-deploy-accept glassine-switch-hook glassine-hibernate \
		glassine-device-seed glassine-devmode; do
		install -Dm755 sbin/$f "$pkgdir"/usr/sbin/$f
	done
	for f in glassine-switch glassine-mount-ro glassine-deploy-accept glassine-device-seed glassine-devmode; do
		install -Dm755 openrc/$f "$pkgdir"/etc/init.d/$f
	done
	ln -s glassine "$pkgdir"/usr/sbin/apk
	for f in glassine-state.sh glassine-root.sh glassine-accounts.sh glassine-device.sh; do
		install -Dm644 lib/$f "$pkgdir"/usr/lib/glassine-boot/$f
	done
	install -Dm644 conf/deploy.conf.example "$pkgdir"/usr/share/glassine-boot/deploy.conf.example
	install -Dm644 conf/migrate.d/glassine-deploy.list "$pkgdir"/usr/share/glassine/migrate.d/glassine-deploy.list
	install -Dm644 docs/deployments.md "$pkgdir"/usr/share/doc/$pkgname/deployments.md
	install -Dm644 docs/kernel-artifacts.md "$pkgdir"/usr/share/doc/$pkgname/kernel-artifacts.md
	# the accept step runs the same health checks as a kernel test boot (ACCEPT_HEALTH_DIR)
	install -d "$pkgdir"/etc/glassine-bootimg/health.d "$pkgdir"/etc/glassine/hibernate.d
}
sha512sums="
36f1e967c71295b09857ddb1bc80fa58c90e14c295e55ae8735cfbc02d47add343836eafb3049a22e01c4dbae70cf6682f571753fcd87eeba87c13619d7d57c2  boot-ad7f4b8bf7a7ffd30dfaa40768f503fca35a8584.tar.gz
"
