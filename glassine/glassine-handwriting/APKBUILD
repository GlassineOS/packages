# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# glassine-handwriting from GlassineOS/handwriting: the on-device handwriting recognizer
# behind a line contract (docs/recognizer.md) that the on-screen keyboard and apps start
# as a child process. Its base models are glassine-handwriting-model-LANG; in prose fields
# it also reads with the keyboard predictor's words (glassine-predict-model) when installed,
# and with the language's character model (chars.gclm, in glassine-handwriting-model-LANG).
# From the person's samples it makes a letter model and their handwriting font (spec 003),
# installed into the user's font directory; fontconfig's fc-cache makes apps see it at once.
# glassine-handwriting-samples is the handwriting samples app (spec 002): write shown
# text so the recognizer learns the person's hand, and contribute reviewed samples. It shows
# words without ink in Kalam (the design's hand-like face; Alpine doesn't package it), a
# pinned google/fonts file (OFL) as in glassine-shell-fonts.
# glassine-handwriting-service is handwriting for apps (spec 004, docs/service.md): one
# recognizer for every app in the session, the service socket for apps and the channel
# behind the pen interface, which sway-glassine starts it on. libglassine-handwriting
# (-libs, -dev) and py3-glassine-handwriting are the pen interface's client library
# (docs/pen-interface.md).
pkgname=glassine-handwriting
pkgver=0_git20261119
# GlassineOS/handwriting main
_commit=4c80e9efa7ea43649732c9cd9d85ab8ff249ccac
_gf=https://raw.githubusercontent.com/google/fonts/0b58fb370093f9a9f4ff785d94405710b79de67c/ofl
pkgrel=11
pkgdesc="GlassineOS handwriting recognizer"
url="https://github.com/GlassineOS/handwriting"
arch="all"
license="GPL-2.0-or-later"
depends="fontconfig"
makedepends="json-c-dev pkgconf wayland-dev"
# make check: the engine's unit tests, the features and characters against the trainer's
# Python (numpy only), the contract against a tiny test model; no trained model needed;
# the font against fontTools, HarfBuzz's shaper and fontconfig
# the service's tests run its interface against the schema (py3-jsonschema)
checkdepends="python3 py3-numpy py3-fonttools harfbuzz-utils fontconfig py3-jsonschema"
subpackages="$pkgname-doc $pkgname-dev $pkgname-libs $pkgname-samples:samples:noarch
	$pkgname-service:service:noarch py3-$pkgname:py3:noarch"
source="handwriting-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	Kalam-Regular.ttf::$_gf/kalam/Kalam-Regular.ttf
	Kalam-OFL.txt::$_gf/kalam/OFL.txt
	"
builddir="$srcdir/handwriting-$_commit/recognizer"

build() {
	make
	make -C ../client O=out
}

check() {
	make check
	# the samples app's flows against the recognizer just built (no toolkit needed)
	make -C ../samples check HW_BIN="$builddir"/glassine-handwriting
	# the service and its interface (the pen interface end to end runs in the
	# repository's CI, against sway's stand-in compositor)
	make -C ../service check HW_BIN="$builddir"/glassine-handwriting
}

package() {
	make DESTDIR="$pkgdir" PREFIX=/usr install
	make -C ../client O=out DESTDIR="$pkgdir" PREFIX=/usr install
	install -Dm644 ../docs/recognizer.md ../docs/samples.md ../docs/service.md ../docs/pen-interface.md \
		../docs/service.schema.json -t "$pkgdir"/usr/share/doc/$pkgname/
}

libs() {
	pkgdesc="GlassineOS handwriting: the pen interface's client library"
	depends=""
	amove usr/lib/libglassine-handwriting.so.*
}

py3() {
	pkgdesc="GlassineOS handwriting: the pen interface for Python apps"
	depends="$pkgname-libs=$pkgver-r$pkgrel python3"
	amove usr/lib/glassine/python
}

service() {
	pkgdesc="GlassineOS handwriting service: handwriting for apps"
	depends="$pkgname=$pkgver-r$pkgrel python3"
	make -C "$builddir"/../service DESTDIR="$subpkgdir" PREFIX=/usr install
}

samples() {
	pkgdesc="GlassineOS handwriting samples app"
	license="GPL-2.0-or-later AND OFL-1.1"
	depends="$pkgname=$pkgver-r$pkgrel py3-$pkgname=$pkgver-r$pkgrel $pkgname-service=$pkgver-r$pkgrel gtk+3.0 py3-cairo py3-glassine-ui py3-gobject3 python3"
	make -C "$builddir"/../samples DESTDIR="$subpkgdir" PREFIX=/usr install
	install -Dm644 "$srcdir"/Kalam-Regular.ttf -t "$subpkgdir"/usr/share/fonts/glassine-handwriting/
	install -Dm644 "$srcdir"/Kalam-OFL.txt "$subpkgdir"/usr/share/licenses/$subpkgname/Kalam-OFL-1.1.txt
}

sha512sums="
178540865905eaa6b044db2bc097f7c848b6b57a37c910c3799b715e759bc52b64f50d0e10e462b8cdab225a9648425872b2c8ffb9232514953038a45471dbf3  handwriting-4c80e9efa7ea43649732c9cd9d85ab8ff249ccac.tar.gz
9c48be00cf86765639724b93e4f3525330c93cea4825d0cff19cd43d52b0317db764b5173055210cdb303c2857bf426dd3c86f113fc45fbe0ab75888a79334db  Kalam-Regular.ttf
eae53aa2ac365f68cf77751d2ceca71b7ac78d48bd606a987754742926caeafb811e9bc1b9c69183a83f971a7c9cc388c56195392a87486aa167186e691f1eab  Kalam-OFL.txt
"
