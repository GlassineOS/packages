# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# The Home screen, from GlassineOS/home: pages of widgets on a grid that fills the window,
# drawn with GlassineOS/ui at the size of the interface (its size API, glassine-ui 1.4.0),
# and the sandboxed Lua widget runtime (glassine-home-run). The session
# (glassine-shell) starts it as the home app (app_id glassine-home) and keeps it in
# sway's scratchpad.
pkgname=glassine-home
pkgver=0_git20261114
# GlassineOS/home main
_commit=7cad964795727f43618014c152998575ab71b30c
pkgrel=1
pkgdesc="GlassineOS Home screen and its widget runtime"
url="https://github.com/GlassineOS/home"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	cairo-dev
	gdk-pixbuf-dev
	glassine-ui-dev>=1.4.0
	glib-dev
	librsvg-dev
	libxkbcommon-dev
	linux-headers
	lua5.4-dev
	pango-dev
	wayland-dev
	wayland-protocols
	"
# the screen tests draw the design's boards offscreen with these fonts and icons
checkdepends="
	adwaita-icon-theme
	font-dejavu
	font-eb-garamond
	"
source="home-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/home-$_commit"

build() {
	make UI_SYSTEM=1 PREFIX=/usr
}

check() {
	make UI_SYSTEM=1 PREFIX=/usr check
}

package() {
	make UI_SYSTEM=1 DESTDIR="$pkgdir" PREFIX=/usr install
}
sha512sums="
