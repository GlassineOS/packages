# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# The Home screen, from GlassineOS/home: pages of widgets on a grid that fills the window,
# drawn with GlassineOS/ui at the size of the interface (its size API; its content rule
# says a tap's answer is a page: glassine-ui 1.5.0), and the sandboxed Lua widget runtime
# (glassine-home-run). The session (glassine-shell) starts it as the home app (app_id
# glassine-home) and keeps it in sway's scratchpad.
pkgname=glassine-home
pkgver=0_git20261114
# GlassineOS/home main
_commit=4787c322c8e81c632fcc7228b4b40be04aa11a00
pkgrel=3
pkgdesc="GlassineOS Home screen and its widget runtime"
url="https://github.com/GlassineOS/home"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	cairo-dev
	gdk-pixbuf-dev
	glassine-ui-dev>=1.5.0
	glib-dev
	librsvg-dev
	libxkbcommon-dev
	linux-headers
	lua5.4-dev
	pango-dev
	wayland-dev
	wayland-protocols
	"
# the screen tests draw the design's boards offscreen with these fonts and icons
checkdepends="
	adwaita-icon-theme
	font-dejavu
	font-eb-garamond
	"
source="home-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/home-$_commit"

build() {
	make UI_SYSTEM=1 PREFIX=/usr
}

check() {
	make UI_SYSTEM=1 PREFIX=/usr check
}

package() {
	make UI_SYSTEM=1 DESTDIR="$pkgdir" PREFIX=/usr install
}
sha512sums="
e3e094115568198bb1efa64ba6a476063f39d190385463d47b9bef2ba7c45afe8ab162235fb17288a35cc627c3769f3f36acf1f041ab5d2e981f4ff108df2a61  home-4787c322c8e81c632fcc7228b4b40be04aa11a00.tar.gz
"
