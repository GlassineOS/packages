# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# The planner, from GlassineOS/planner: day, week and month pages written with the pen,
# drawn with GlassineOS/ui. Every field is a writing region of the handwriting service,
# which reads what is written; without it the planner says so and doesn't start.
# Installs the program and its desktop entry (the launcher's "Planner").
pkgname=glassine-planner
pkgver=0_git20261121
# GlassineOS/planner main
_commit=dfe7ccc7ba7ba78194c1560cba00ca1511683b82
pkgrel=16
pkgdesc="GlassineOS planner: days, weeks and months written with the pen"
url="https://github.com/GlassineOS/planner"
arch="all"
license="GPL-2.0-or-later"
# the region display (Set in Autograph) needs the client library and service of r16;
# wrapped lines are spaced by ui_text_wrap of glassine-ui 1.5.1
depends="glassine-handwriting-service>=0_git20261119-r16 glassine-handwriting-libs>=0_git20261119-r16 glassine-ui>=1.5.1"
makedepends="
	cairo-dev
	glassine-handwriting-dev>=0_git20261119-r16
	glassine-ui-dev>=1.5.1
	glib-dev
	librsvg-dev
	libxkbcommon-dev
	linux-headers
	pango-dev
	wayland-dev
	wayland-protocols
	"
# the view tests and renders draw the boards offscreen with these fonts
checkdepends="
	font-dejavu
	font-eb-garamond
	"
source="planner-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/planner-$_commit"

build() {
	make UI_SYSTEM=1 PREFIX=/usr
}

check() {
	make UI_SYSTEM=1 PREFIX=/usr check
}

package() {
	make UI_SYSTEM=1 DESTDIR="$pkgdir" PREFIX=/usr install
}
sha512sums="
f1d9fd20286f62b4eefec1fcbd7419bd247729ac2599508b88a08614ddb6eabc7284e4f064385859195aaa10520fca78c4e1427b8f7745b393400f281b082e04  planner-dfe7ccc7ba7ba78194c1560cba00ca1511683b82.tar.gz
"
