# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# glassine-reboot and glassine-reboot-clean from GlassineOS/boot: a reboot with a
# reason (recovery, bootloader) for the bootloader to act on. glassine-reboot-clean
# records the reason and hands the reboot to init: init stops the services and
# makes the root read-only, and its last shutdown service (glassine-reboot-reason)
# reboots with the reason. The desktop's "Recovery" entry uses it. reboot, as
# /usr/sbin/reboot ahead of busybox's /sbin/reboot on PATH, hands a reason
# (`reboot bootloader`) to glassine-reboot-clean; without one it is busybox reboot.
pkgname=glassine-reboot
pkgver=0.3.0
# GlassineOS/boot main (as glassine-slot)
_commit=586075a9fb198b9b111be5654c93f436b544af19
pkgrel=0
pkgdesc="GlassineOS reboot with a reason (recovery, bootloader)"
url="https://github.com/GlassineOS/boot"
arch="all"
license="GPL-2.0-or-later"
depends="openrc"
makedepends="linux-headers"
options="!check" # boot's tests for these run in its CI (a VM)
source="boot-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
builddir="$srcdir/boot-$_commit"

build() {
	make CFLAGS="$CFLAGS -Wall" glassine-reboot
}

package() {
	install -Dm755 glassine-reboot "$pkgdir"/usr/sbin/glassine-reboot
	install -Dm755 sbin/glassine-reboot-clean "$pkgdir"/usr/sbin/glassine-reboot-clean
	install -Dm755 sbin/reboot "$pkgdir"/usr/sbin/reboot
	install -Dm755 openrc/glassine-reboot-reason "$pkgdir"/etc/init.d/glassine-reboot-reason
}
sha512sums="
2d82b456fcf7269e3d3646994efc0d710f3661f8a38165630dc1252147a5e393d066d6f8364fc5d256e2880d72ba4fdddd2441da4ebe05568c42a2695ea76fed  boot-586075a9fb198b9b111be5654c93f436b544af19.tar.gz
"
