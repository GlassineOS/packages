# Maintainer: Moritz Meißelbach <moritz@glassine.org>
# The e-ink desktop around the apps, from GlassineOS/shell: the bar and its views
# (glassine-shell), the window model (glassine-swayd), the settings app, the
# first-run setup, the sway session with its services and root helpers, the
# background-app manager (glassine-bgprio, glassine-zpark), the zram swap service
# (glassine-zram), the GTK themes and the glassine-mono icons. The voices and the drawing
# come from GlassineOS/ui (glassine-ui, and py3-glassine-ui for the Python apps). The theme
# fonts that Alpine doesn't package are in glassine-shell-fonts (pinned google/fonts files, OFL).
#
# Optional, used when installed: grim (Print key), foot (terminal key),
# alpine-appstream-downloader (app catalogue on connect), xdg-user-dirs,
# btrfs-progs (glassine-zram's compressed spill; a plain file without it).
# The glassine-zram service isn't enabled here: an image adds it to a runlevel.
pkgname=glassine-shell
pkgver=0_git20261112
# GlassineOS/shell main
_commit=73166dbe4682fd78ef4770b274ef9ba21145d6b2
# google/fonts, as in the shell's fonts/fetch-fonts.sh
_gf=https://raw.githubusercontent.com/google/fonts/0b58fb370093f9a9f4ff785d94405710b79de67c/ofl
pkgrel=0
pkgdesc="GlassineOS e-ink desktop: shell, window model, settings, sway session"
url="https://github.com/GlassineOS/shell"
arch="all"
license="GPL-2.0-or-later AND CC-BY-SA-4.0"
# swaymsg comes from Alpine's sway; sway-glassine is the compositor the session runs;
# glassine-reboot: the power menu's Recovery (glassine-power-root)
depends="
	$pkgname-fonts
	at-spi2-core
	blueman
	bluez
	dbus
	doas
	flock
	glassine-epdd-desktop
	glassine-reboot
	glassine-ui
	glib
	gtk+3.0
	librsvg
	networkmanager-cli
	pango
	pipewire
	playerctl
	pulseaudio-utils
	py3-cairo
	py3-glassine-ui
	py3-gobject3
	python3
	seatd
	sway
	sway-glassine
	wireplumber
	wvkbd-glassine
	"
makedepends="
	cairo-dev
	glassine-ui-dev
	glib-dev
	gtk+3.0-dev
	json-c-dev
	libxkbcommon-dev
	librsvg-dev
	pango-dev
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-fonts:fonts:noarch"
install="$pkgname.pre-install"
source="shell-$_commit.tar.gz::https://github.com/GlassineOS/shell/archive/$_commit.tar.gz
	IBMPlexSans-VF.ttf::$_gf/ibmplexsans/IBMPlexSans%5Bwdth%2Cwght%5D.ttf
	IBMPlexMono-Regular.ttf::$_gf/ibmplexmono/IBMPlexMono-Regular.ttf
	IBMPlexMono-Medium.ttf::$_gf/ibmplexmono/IBMPlexMono-Medium.ttf
	IBMPlexMono-SemiBold.ttf::$_gf/ibmplexmono/IBMPlexMono-SemiBold.ttf
	SourceSerif4-VF.ttf::$_gf/sourceserif4/SourceSerif4%5Bopsz%2Cwght%5D.ttf
	SourceSerif4-Italic-VF.ttf::$_gf/sourceserif4/SourceSerif4-Italic%5Bopsz%2Cwght%5D.ttf
	NotoEmoji-VF.ttf::$_gf/notoemoji/NotoEmoji%5Bwght%5D.ttf
	"
builddir="$srcdir/shell-$_commit"

build() {
	make
}

check() {
	# make check needs Docker (its tests run in their own containers); here only
	# what runs in the build: every script parses
	local f
	for f in $(grep -rlE '^#!.*python' rootfs) $(find rootfs -name '*.py'); do
		python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f"
	done
	for f in $(grep -rlE '^#!/bin/sh' rootfs); do
		sh -n "$f"
	done
}

package() {
	mkdir -p "$pkgdir"
	cp -a rootfs/. "$pkgdir"/
	install -Dm755 glassine-shell glassine-swayd -t "$pkgdir"/usr/bin/
	install -Dm755 glassine-bgprio glassine-zpark -t "$pkgdir"/usr/sbin/
	chmod 0644 "$pkgdir"/etc/doas.d/glassine.conf
	install -Dm644 rootfs/usr/share/icons/glassine-mono/LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/icons-CC-BY-SA-4.0
}

fonts() {
	pkgdesc="Theme fonts of the GlassineOS e-ink desktop (IBM Plex, Source Serif 4, Noto Emoji, EB Garamond)"
	license="OFL-1.1"
	depends="font-eb-garamond"
	install -Dm644 "$srcdir"/IBMPlex*.ttf "$srcdir"/SourceSerif4*.ttf "$srcdir"/NotoEmoji-VF.ttf \
		-t "$subpkgdir"/usr/share/fonts/glassine/
}

