#!/bin/sh
# One GlassineOS repository line, the one this package ships: it takes the place of the
# first GlassineOS line of any Alpine release (so a release change moves the system to
# the new repository), other GlassineOS lines go, and it is added if there was none.
line=$(cat /usr/share/glassine/apk-repository) || exit 0
f=/etc/apk/repositories
[ -f "$f" ] || { echo "$line" > "$f"; exit 0; }
awk -v line="$line" '
	/^https:\/\/pkgs\.glassine\.org\/alpine\/[^\/]+\/glassine\/?$/ {
		if (!done) print line; done = 1; next
	}
	{ print }
	END { if (!done) print line }
' "$f" > "$f.new" && cat "$f.new" > "$f"
rm -f "$f.new"
exit 0
